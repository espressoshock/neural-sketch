% expands and evaluates math op / works on int and float
\NewExpandableDocumentCommand \e { r<> }
  { \fp_to_decimal:n { \fp_eval:n {#1} } }

% ─────────────────────────────────────────────────────────────────────────────
% nskLerp: linear interpolation tool for drawing (supports [0–1] & [0–100])
% ─────────────────────────────────────────────────────────────────────────────
\keys_define:nn { nsk/lerp }
{
	from       .fp_set:N   = \l__nsk_lerp_min_fp,
	from       .initial:n  = {0.0},
	from       .default:n  = {0.0},

	to       .fp_set:N   = \l__nsk_lerp_max_fp,
	to       .initial:n  = {100.0},
	to       .default:n  = {100.0},

	n .int_set:N  = \l__nsk_lerp_nelements_int,
	n .initial:n  = {1},
	n .default:n  = {1},

	into      .tl_set:N   = \l__nsk_lerp_into_tl,
	into      .initial:n  = {},
}

\NewDocumentCommand \nskLerp { om }
{
	% #1 = optional key list, #2 = index
	\keys_set:nn { nsk/lerp } { #1 }

	% scale [0–1] → [0–100] if needed
	\fp_set_eq:NN \l__nsk_lerp_min_scaled_fp \l__nsk_lerp_min_fp
	\fp_set_eq:NN \l__nsk_lerp_max_scaled_fp \l__nsk_lerp_max_fp
	\fp_compare:nNnTF { \l__nsk_lerp_max_scaled_fp } ? { 1 }
	{
		\fp_set:Nn \l__nsk_lerp_min_scaled_fp { \l__nsk_lerp_min_scaled_fp * 100 }
		\fp_set:Nn \l__nsk_lerp_max_scaled_fp { \l__nsk_lerp_max_scaled_fp * 100 }
	}
	{}

	% compute interpolation
	\int_compare:nNnTF { #2 } = { 1 }
	  {
	    \fp_set_eq:NN \l__nsk_lerp_pct_fp \l__nsk_lerp_min_scaled_fp
	  }
	  {
	    \fp_set:Nn \l__nsk_lerp_pct_fp
	      {
	        \l__nsk_lerp_min_scaled_fp
	        +
	        ( #2 - 1 )
	        /
	        ( \l__nsk_lerp_nelements_int - 1 )
	        *
	        ( \l__nsk_lerp_max_scaled_fp - \l__nsk_lerp_min_scaled_fp )
	      }
	  }

	% store into user’s macro
	\tl_if_empty:NF \l__nsk_lerp_into_tl
	  {
	    \expandafter
	    \tl_set:Nx
	      \csname \l__nsk_lerp_into_tl\endcsname
	      { \fp_to_decimal:N \l__nsk_lerp_pct_fp }
	  }
}

