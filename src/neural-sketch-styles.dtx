% implementation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
%<*package>
%    \begin{macrocode}
\ExplSyntaxOn

% globals ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\dim_new:N \g__nsk_style_container_padding_dim

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global package styles
% The user can write:  block-fill=orange
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\keys_define:nn { nsk / style }
{
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% nsk / Block
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	block-fill .tl_gset:N = \g__nsk_style_block_fill_tl,
	block-fill .initial:n = { nskLightGray },
	block-fill .default:n = { nskLightGray },

	block-border-color .tl_gset:N = \g__nsk_style_block_border_color_tl,
	block-border-color .initial:n = { nskDarkGray },
	block-border-color .default:n = { nskDarkGray },

	block-x .fp_gset:N = \g__nsk_style_block_x_fp,
	block-x .initial:n = {0},
	block-x .default:n = {0},

	block-y .fp_gset:N = \g__nsk_style_block_y_fp,
	block-y .initial:n = {0},
	block-y .default:n = {0},

	block-anchor .tl_gset:N = \g__nsk_style_block_anchor_tl,
	block-anchor .initial:n = {},
	block-anchor .default:n = {},

	block-border-radius .dim_gset:N = \g__nsk_style_block_border_radius_dim,
	block-border-radius .initial:n = {2.5mm},
	block-border-radius .default:n = {2.5mm},

	block-embed-border-radius .dim_gset:N = \g__nsk_style_block_embed_border_radius_dim,
	block-embed-border-radius.initial:n = {1.3mm},
	block-embed-border-radius.default:n = {1.3mm},

	block-embed-border-size .dim_gset:N = \g__nsk_style_block_embed_border_size_dim,
	block-embed-border-size .initial:n = {1pt},
	block-embed-border-size .default:n = {1pt},

	block-embed-padding .dim_gset:N = \g__nsk_style_block_embed_padding_dim,
	block-embed-padding .initial:n = {1mm},
	block-embed-padding .default:n = {1mm},

	block-border-size .dim_gset:N = \g__nsk_style_block_border_size_dim,
	block-border-size .initial:n = {.4mm},
	block-border-size .default:n = {.4mm},

	block-width  .dim_gset:N = \g__nsk_style_block_width_dim,
	block-width  .initial:n = {1cm},
	block-width  .default:n = {1cm},

	block-height .dim_gset:N = \g__nsk_style_block_height_dim,
	block-height .initial:n = {1cm},
	block-height .default:n = {1cm},

	block-importance .fp_gset:N = \g__nsk_style_block_importance_fp,
	block-importance .initial:n = {1.0},
	block-importance .default:n = {1.0},

	% text-anchoring ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	text-north-loc .tl_gset:N = \g__nsk_style_text_north_loc_tl,
	text-north-loc .initial:n = {},
	text-north-loc .default:n = {},

	text-south-loc .tl_gset:N = \g__nsk_style_text_south_loc_tl,
	text-south-loc .initial:n = {},
	text-south-loc .default:n = {},

	text-east-loc .tl_gset:N = \g__nsk_style_text_east_loc_tl,
	text-east-loc .initial:n = {},
	text-east-loc .default:n = {},

	text-west-loc .tl_gset:N = \g__nsk_style_text_west_loc_tl,
	text-west-loc .initial:n = {},
	text-west-loc .default:n = {},

	text-center-loc .tl_gset:N = \g__nsk_style_text_center_loc_tl,
	text-center-loc .initial:n = {},
	text-center-loc .default:n = {},

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% nsk / Container
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	container-border-color .tl_gset:N = \g__nsk_style_container_border_color_tl,
	container-border-color .initial:n = { nskLighterGray },

	container-border-type .tl_gset:N = \g__nsk_style_container_border_type_tl,
	container-border-type .initial:n = { solid },

	container-fill .tl_gset:N = \g__nsk_style_container_fill_tl,
	container-fill .initial:n = { nskLightestGray },
	container-fill .default:n = { nskLightestGray },

	container-padding .dim_gset:N = \g__nsk_style_container_padding_dim,
	container-padding .initial:n = { .5cm },
	container-padding .default:n = { .5cm },

	container-shift-x .fp_gset:N = \g__nsk_style_container_x_fp,
	container-shift-x .initial:n = { 0 },
	container-shift-x .default:n = { 0 },

	container-shift-y .fp_gset:N = \g__nsk_style_container_y_fp,
	container-shift-y .initial:n = { 0 },
	container-shift-y .default:n = { 0 },

	container-rotate .fp_gset:N = \g__nsk_style_container_rotate_fp,
	container-rotate .initial:n = { 0 },
	container-rotate .default:n = { 0 },

	container-scale .fp_gset:N = \g__nsk_style_container_scale_fp,
	container-scale .initial:n = { 1 },
	container-scale .default:n = { 1 },

	container-anchor .tl_gset:N = \g__nsk_style_container_anchor_tl,
	container-anchor .initial:n = {},
	container-anchor .default:n = {},

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% bridging
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	bridging-style .tl_gset:N = \g__nsk_style_bridging_style_tl,
	bridging-style .initial:n = {arc},
	bridging-style .default:n = {arc},

	bridging-span .dim_gset:N = \g__nsk_style_bridging_span_dim,
	bridging-span .initial:n = {8pt},
	bridging-span .default:n = {8pt},

	bridging-gap .dim_gset:N = \g__nsk_style_bridging_gap_dim,
	bridging-gap .initial:n = {4pt},
	bridging-gap .default:n = {4pt},

	arrow-tip .tl_gset:N = \g__nsk_style_arrow_tip_tl,
	arrow-tip .initial:n = {-},
	arrow-tip .default:n = {-},

	arrow-style .tl_gset:N = \g__nsk_style_arrow_style_tl,
	arrow-style .initial:n = {ultra~thick, line~cap=round},
	arrow-style .default:n = {ultra~thick, line~cap=round},

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Outer-border
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	block-outer-border-type .tl_gset:N = \g__nsk_style_block_outer_border_type_tl,
	block-outer-border-type .initial:n = {none},
	block-outer-border-type .default:n = {none},

	block-outer-border-color .tl_gset:N = \g__nsk_style_block_outer_border_color_tl,
	block-outer-border-color .initial:n = {nskMainAccent!50!nskBg},
	block-outer-border-color .default:n = {nskMainAccent!50!nskBg},

	block-outer-border-radius .dim_gset:N = \g__nsk_style_block_outer_border_radius_dim,
	block-outer-border-radius .initial:n = {2.5mm},
	block-outer-border-radius .default:n = {2.5mm},

	block-outer-border-size .dim_gset:N = \g__nsk_style_block_outer_border_size_dim,
	block-outer-border-size .initial:n = {5mm},
	block-outer-border-size .default:n = {5mm},

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Stacks
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	block-stack-opts .tl_gset:N = \g__nsk_style_block_stack_opts_tl,
	block-stack-opts .initial:n = {opacity=.6},
	block-stack-opts .default:n = {opacity=.6},

	block-stack-xoffset .dim_gset:N = \g__nsk_style_block_stack_xoffset_dim,
	block-stack-xoffset .initial:n  = {1mm},
	block-stack-xoffset .default:n  = {1mm},

	block-stack-yoffset .dim_gset:N = \g__nsk_style_block_stack_yoffset_dim,
	block-stack-yoffset .initial:n  = {-.8mm},
	block-stack-yoffset .default:n  = {-.8mm},

	block-stack-count .tl_gset:N = \g__nsk_style_block_stack_count_tl,
	block-stack-count .initial:n = {single},
	block-stack-count .default:n = {single},

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% nsk / Zoom
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	zoom-type .tl_gset:N = \g__nsk_style_zoom_type_tl,
	zoom-type .initial:n = {circle},
	zoom-type .default:n = {circle},

	zoom-at .tl_gset:N = \g__nsk_style_zoom_at_tl,
	zoom-at .initial:n = {},
	zoom-at .default:n = {},

	zoom-to .tl_gset:N = \g__nsk_style_zoom_to_tl,
	zoom-to .initial:n = {},
	zoom-to .default:n = {},

	zoom-magnification .tl_gset:N = \g__nsk_style_zoom_magnification_tl,
	zoom-magnification .initial:n = {4},
	zoom-magnification .default:n = {4},

	zoom-size .dim_gset:N = \g__nsk_style_zoom_size_dim,
	zoom-size .initial:n = {2cm},
	zoom-size .default:n = {2cm},

	zoom-callout-style .tl_gset:N = \g__nsk_style_zoom_callout_style_tl,
	zoom-callout-style .initial:n = {thick, densely~dashed},
	zoom-callout-style .default:n = {thick, densely~dashed},

	zoom-connecting-style .tl_gset:N = \g__nsk_style_zoom_connecting_style_tl,
	zoom-connecting-style .initial:n = {\g__nsk_style_block_border_color_tl},
	zoom-connecting-style .default:n = {\g__nsk_style_block_border_color_tl},

	zoom-callout-border-color .tl_gset:N = \g__nsk_style_zoom_callout_border_color_tl,
	zoom-callout-border-color .initial:n = {\g__nsk_style_block_border_color_tl},
	zoom-callout-border-color .default:n = {\g__nsk_style_block_border_color_tl},

	zoom-zoomed-style .tl_gset:N = \g__nsk_style_zoom_zoomed_style_tl,
	zoom-zoomed-style .initial:n = {draw=\g__nsk_style_block_border_color_tl, ultra~thick},
	zoom-zoomed-style .default:n = {draw=\g__nsk_style_block_border_color_tl, ultra~thick},

	zoom-zoomed-fill .tl_gset:N = \g__nsk_style_zoom_zoomed_fill_tl,
	zoom-zoomed-fill .initial:n = {none},
	zoom-zoomed-fill .default:n = {none},

	zoom-connecting-path .tl_gset:N = \g__nsk_style_zoom_connecting_path_tl,
	zoom-connecting-path .initial:n = {\draw[\g__nsk_style_zoom_connecting_style_tl] (tikzspyonnode) -- (tikzspyinnode);},
	zoom-connecting-path .default:n = {\draw[\g__nsk_style_zoom_connecting_style_tl] (tikzspyonnode) -- (tikzspyinnode);},

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% nsk / Measure
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	measure-axis .tl_gset:N = \g__nsk_style_measure_axis_tl,
	measure-axis .initial:n = {horizontal},
	measure-axis .default:n = {horizontal},

	measure-from .tl_gset:N = \g__nsk_style_measure_from_tl,
	measure-from .initial:n = {},
	measure-from .default:n = {},

	measure-to .tl_gset:N = \g__nsk_style_measure_to_tl,
	measure-to .initial:n = {},
	measure-to .default:n = {},
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Aliases
% A property to hold short aliases that map to
% standard TikZ pattern names.
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prop_new:N \g_nsk_pattern_aliases_prop

\prop_put:Nnn \g_nsk_pattern_aliases_prop { hlines } { horizontal\space lines }
\prop_put:Nnn \g_nsk_pattern_aliases_prop { vlines } { vertical\space lines }
\prop_put:Nnn \g_nsk_pattern_aliases_prop { hatch } { north\space east\space lines }
\prop_put:Nnn \g_nsk_pattern_aliases_prop { rhatch } { north\space west\space lines }


% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Tikz styles
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\ExplSyntaxOff
\tikzset{
	nskShadow/.style={
			drop shadow={
					shadow xshift=-.1ex,
					shadow yshift=-.6ex,
					fill=nskLighterGray!80,
				},
		},
	bridging path/.initial=\g__nsk_style_bridging_style_tl,
	bridging span/.initial=\dim_use:N \g__nsk_style_bridging_span_dim,
	bridging gap/.initial=\dim_use:N \g__nsk_style_bridging_gap_dim,
	bridge/.style 2 args={
			spath/split at intersections with={#1}{#2},
			spath/insert gaps after components={#1}{\pgfkeysvalueof{/tikz/bridging span}},
			spath/join components upright with={#1}{\pgfkeysvalueof{/tikz/bridging path}},

			spath/split at intersections with={#2}{#1},
			spath/insert gaps after components={#2}{\pgfkeysvalueof{/tikz/bridging gap}},
		}
}

\tikzfading[name=fade-left,
	left color=white,
	right color=transparent!100]
\tikzfading[name=fade-right,
	left color=transparent!100,
	right color=white]
\tikzfading[name=fade-up,
	bottom color=transparent!100,
	top color=white]
\tikzfading[name=fade-down,
	bottom color=white,
	top color=transparent!100]

\tikzset{
	fade left/.style={
			fill=white,
			path fading=fade-left
		},
	fade right/.style={
			fill=white,
			path fading=fade-right
		},
	fade up/.style={
			fill=white,
			path fading=fade-up
		},
	fade down/.style={
			% fill=white,
			path fading=fade-down
		}
}

\ExplSyntaxOn

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Public Interface
% - (user-facing)
% () Provide a simple public macro to set these style keys in one line:
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
% WARNING: only for internal-use, deprecated in favor of pkgopts
\NewDocumentCommand \nskSetStyle { O{} }
{
	% #1 is the keyval list, e.g.  block-fill=yellow, block-border=blue
	\keys_set:nn { nsk / style }{ #1 }
}

\ExplSyntaxOff
