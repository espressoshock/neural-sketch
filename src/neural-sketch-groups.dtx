% ---------------------------------------------------------------------
% 1) Global Data Structures
% ---------------------------------------------------------------------
\prop_new:N \l_nsk_group_unknown_prop
\cs_generate_variant:Nn \str_if_in:nnTF { Vn }
\cs_generate_variant:Nn \str_if_in:nnT { Vn }
\cs_generate_variant:Nn \str_if_in:nnF { Vn }
\cs_generate_variant:Nn \seq_set_split:Nnn { NnV }

% ---------------------------------------------------------------------
% Measurement Mode Infrastructure
% Used for pre-measuring container content to compute anchor offsets
% ---------------------------------------------------------------------
\bool_new:N \g__nsk_measurement_mode_bool
\bool_gset_false:N \g__nsk_measurement_mode_bool

% Global dimensions for measurement results (must be global to escape the savebox)
\dim_new:N \g__nsk_group_measured_width_dim
\dim_new:N \g__nsk_group_measured_height_dim
\tl_set:Nn \l_nsk_group_refnode_id_tl {__nsk_phantom_refnode}

% Stack implementation for nesting support
\int_new:N \g_nsk_group_stack_level_int
\int_gset:Nn \g_nsk_group_stack_level_int {0}

% Create property sequences for each nesting level
% \seq_new:N \g_nsk_group_bounds_name_stack_seq
\seq_new:N \g_nsk_group_pos_stack_seq
\seq_new:N \g_nsk_group_last_pos_stack_seq
\seq_new:N \g_nsk_pos_align_stack_seq
\seq_new:N \g_nsk_group_x_stack_seq
\seq_new:N \g_nsk_group_y_stack_seq
\seq_new:N \g_nsk_group_rotate_stack_seq
\seq_new:N \g_nsk_group_scale_stack_seq

\seq_new:N \g_nsk_group_extra_style_stack_seq
\seq_new:N \g_nsk_group_bounds_name_stack_seq
\seq_new:N \g_nsk_group_ps_dira_stack_seq
\seq_new:N \g_nsk_group_ps_dirb_stack_seq
\seq_new:N \g_nsk_group_skip_pos_counter_stack_seq
\seq_new:N \g_nsk_group_align_stack_seq
\tl_new:N \l_nsk_group_align_tl
\bool_new:N \l_nsk_group_scope_first_pos_bool

% Helper functions to push and pop from stacks
\cs_new_protected:Npn \nsk__group_push_to_stack:
{
	\int_gincr:N \g_nsk_group_stack_level_int

	% Push current values to stacks
	\seq_gpush:NV \g_nsk_group_bounds_name_stack_seq \l_nsk_group_bounds_name_tl
	\seq_gpush:NV \g_nsk_group_pos_stack_seq \l_nsk_group_pos_tl
	\seq_gpush:NV \g_nsk_group_last_pos_stack_seq \l_nsk_group_last_pos_tl
	\seq_gpush:NV \g_nsk_pos_align_stack_seq \l_nsk_pos_align_tl
	\seq_gpush:Nx \g_nsk_group_x_stack_seq {\fp_use:N \l_nsk_group_x_fp}
	\seq_gpush:Nx \g_nsk_group_y_stack_seq {\fp_use:N \l_nsk_group_y_fp}
	\seq_gpush:Nx \g_nsk_group_rotate_stack_seq {\fp_use:N \l_nsk_group_rotate_fp}
	\seq_gpush:Nx \g_nsk_group_scale_stack_seq {\fp_use:N \l_nsk_group_scale_fp}
	\seq_gpush:NV \g_nsk_group_ps_dira_stack_seq \l_nsk_group_ps_dira_tl
	\seq_gpush:NV \g_nsk_group_ps_dirb_stack_seq \l_nsk_group_ps_dirb_tl
	\seq_gpush:NV \g_nsk_group_align_stack_seq \l_nsk_group_align_tl

	% Save skip-pos counter state
	\seq_gpush:Nx \g_nsk_group_skip_pos_counter_stack_seq
		{\int_use:N \g_nsk_block_skip_pos_counter_int}

	% Create a unique refnode ID for this level
	\tl_set:Nx \l_nsk_group_refnode_id_tl {__nsk_phantom_refnode_\int_use:N \g_nsk_group_stack_level_int}

	% Clear local variables for this new level
	\tl_clear:N \l_nsk_group_bounds_name_tl
	\tl_clear:N \l_nsk_group_pos_tl
	\tl_clear:N \l_nsk_group_last_pos_tl
	\tl_clear:N \l_nsk_pos_align_tl
	\tl_clear:N \l_nsk_group_ps_dira_tl
	\tl_clear:N \l_nsk_group_ps_dirb_tl
	\tl_clear:N \l_nsk_group_align_tl
	\fp_zero:N \l_nsk_group_x_fp
	\fp_zero:N \l_nsk_group_y_fp
	\fp_zero:N \l_nsk_group_rotate_fp
	\fp_set:Nn \l_nsk_group_scale_fp {1.0}

	% Clear the unknown properties
	\prop_clear:N \l_nsk_group_unknown_prop
}

\cs_new_protected:Npn \nsk__group_pop_from_stack:
{
	% Only pop if we have something on the stack
	\int_compare:nNnT \g_nsk_group_stack_level_int > 0
		{
			% Restore values from stack
			\tl_set:Nx \l_nsk_group_bounds_name_tl {\seq_item:Nn \g_nsk_group_bounds_name_stack_seq {1}}
			\tl_set:Nx \l_nsk_group_pos_tl {\seq_item:Nn \g_nsk_group_pos_stack_seq {1}}
			\tl_set:Nx \l_nsk_group_last_pos_tl {\seq_item:Nn \g_nsk_group_last_pos_stack_seq {1}}
			\tl_set:Nx \l_nsk_pos_align_tl {\seq_item:Nn \g_nsk_pos_align_stack_seq {1}}
			\fp_set:Nn \l_nsk_group_x_fp {\seq_item:Nn \g_nsk_group_x_stack_seq {1}}
			\fp_set:Nn \l_nsk_group_y_fp {\seq_item:Nn \g_nsk_group_y_stack_seq {1}}
			\fp_set:Nn \l_nsk_group_rotate_fp {\seq_item:Nn \g_nsk_group_rotate_stack_seq {1}}
			\fp_set:Nn \l_nsk_group_scale_fp {\seq_item:Nn \g_nsk_group_scale_stack_seq {1}}
			\tl_set:Nx \l_nsk_group_ps_dira_tl {\seq_item:Nn \g_nsk_group_ps_dira_stack_seq {1}}
			\tl_set:Nx \l_nsk_group_ps_dirb_tl {\seq_item:Nn \g_nsk_group_ps_dirb_stack_seq {1}}
			\tl_set:Nx \l_nsk_group_align_tl {\seq_item:Nn \g_nsk_group_align_stack_seq {1}}

			% Set refnode ID back to previous level
			\int_gdecr:N \g_nsk_group_stack_level_int
			\tl_set:Nx \l_nsk_group_refnode_id_tl {__nsk_phantom_refnode_\int_use:N \g_nsk_group_stack_level_int}
			\int_compare:nNnT \g_nsk_group_stack_level_int = 0
				{
					\tl_set:Nn \l_nsk_group_refnode_id_tl {__nsk_phantom_refnode}
				}

			% Pop from all stacks
			\seq_gpop:NN \g_nsk_group_bounds_name_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_pos_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_last_pos_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_pos_align_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_x_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_y_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_rotate_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_scale_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_ps_dira_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_ps_dirb_stack_seq \l_tmpa_tl
			\seq_gpop:NN \g_nsk_group_align_stack_seq \l_tmpa_tl

			% Restore skip-pos counter state
			\seq_gpop:NN \g_nsk_group_skip_pos_counter_stack_seq \l_tmpa_tl
			\int_gset:Nn \g_nsk_block_skip_pos_counter_int {\l_tmpa_tl}
		}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Content Measurement Function
% Pre-measures content in an isolated tikzpicture to determine bounding box dimensions
% Uses pgfinterruptpicture to avoid polluting the main picture with measurement nodes
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\newsavebox{\nsk@measurebox}

\int_new:N \l__nsk_measure_saved_skip_counter_int

\cs_new_protected:Npn \nsk__group_measure_content:nn #1 #2
{
	% #1 = bounds name for measurement (unused, kept for API compatibility)
	% #2 = content to measure

	% Skip if already in measurement mode (prevent infinite recursion)
	\bool_if:NT \g__nsk_measurement_mode_bool
	{
		\dim_gzero:N \g__nsk_group_measured_width_dim
		\dim_gzero:N \g__nsk_group_measured_height_dim
		\use_none:nn
	}
	\use:n
	{
		% Save skip-pos counter before measurement (measurement pass shouldn't consume it)
		\int_set:Nn \l__nsk_measure_saved_skip_counter_int {\g_nsk_block_skip_pos_counter_int}

		% Enter measurement mode (suppresses ID registration)
		\bool_gset_true:N \g__nsk_measurement_mode_bool

		% Interrupt the current picture and render into an isolated one
		\pgfinterruptpicture
			\savebox{\nsk@measurebox}{%
				\begin{tikzpicture}
					\begin{scope}[local~bounding~box=__nsk_measure_bb]
						#2
					\end{scope}
					% Extract dimensions while still inside the tikzpicture
					\pgfpointanchor{__nsk_measure_bb}{south~west}
					\dim_gset:Nn \g__nsk_group_measured_width_dim { -\pgf@x }
					\dim_gset:Nn \g__nsk_group_measured_height_dim { -\pgf@y }
					\pgfpointanchor{__nsk_measure_bb}{north~east}
					\dim_gadd:Nn \g__nsk_group_measured_width_dim { \pgf@x }
					\dim_gadd:Nn \g__nsk_group_measured_height_dim { \pgf@y }
				\end{tikzpicture}%
			}%
		\endpgfinterruptpicture

		% Exit measurement mode
		\bool_gset_false:N \g__nsk_measurement_mode_bool

		% Restore skip-pos counter after measurement
		\int_gset:Nn \g_nsk_block_skip_pos_counter_int {\l__nsk_measure_saved_skip_counter_int}

		% The savebox is discarded - we only needed it for measurement
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Positioning parsing and smart anchor detections
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__group_parse_pos:
{

% "below right=0cm and 0cm of basics"
\seq_set_split:Nnx \l_tmpa_seq {=}{\l_nsk_group_pos_tl}
% \seq_show:N \l_tmpa_seq

% dira/b
\tl_clear_new:N \l_nsk_group_ps_dira_tl
\tl_clear_new:N \l_nsk_group_ps_dirb_tl

% If there's at least two items, we can inspect the first part
%    (the directions) to pick a multi‐word anchor.
\int_compare:nNnT { \seq_count:N \l_tmpa_seq } > {1}
{
% \l_tmpa_tl := "below right" (for example)
\tl_set:Nx \l_tmpa_lx_tl { \seq_item:Nn \l_tmpa_seq {1} }
% 0cm and 0cm of basics.<..>
\tl_set:Nx \l_tmpa_rx_tl { \seq_item:Nn \l_tmpa_seq {2} }

% split lx side ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
% split below right
\seq_set_split:Nnx \l_tmpa_ps_seq {~} { \tl_use:N \l_tmpa_lx_tl }

\int_compare:nNnT { \seq_count:N \l_tmpa_ps_seq } = {1}
{
\tl_set:Nx \l_nsk_group_ps_dira_tl { \seq_item:Nn \l_tmpa_ps_seq {1} }
}

\int_compare:nNnT { \seq_count:N \l_tmpa_ps_seq } = {2}
{
\tl_set:Nx \l_nsk_group_ps_dira_tl { \seq_item:Nn \l_tmpa_ps_seq {1} }
\tl_set:Nx \l_nsk_group_ps_dirb_tl { \seq_item:Nn \l_tmpa_ps_seq {2} }
}
}

% prepend proper alignmet ~~~~~~~~~~~~~~~~~~~~~ <<<
\str_if_in:NnTF \l_nsk_group_pos_tl {.}
{}
{
	% not given --
	\tl_clear_new:N \l_anchor_tl
	\str_case:Vn \l_nsk_group_ps_dira_tl
	{
		{above}{\tl_set:Nn \l_anchor_tl {north}}
			{below}{\tl_set:Nn \l_anchor_tl {south}}
			{left}{\tl_set:Nn \l_anchor_tl {west}}
			{right}{\tl_set:Nn \l_anchor_tl {east}}
	}

	\tl_put_right:Nx \l_nsk_group_pos_tl
	{.\l_anchor_tl}
}
}

% ---------------------------------------------------------------------
% last-pos logic
% ---------------------------------------------------------------------
\cs_new_protected_nopar:Npn \nsk__process_last_pos_for_group:
{
	% Only proceed if the user gave 'last-pos'
	\tl_if_blank:VF \l_nsk_group_last_pos_tl
	{
		\seq_if_empty:NTF \g_nsk_block_id_history_seq
		{
			\msg_warning:nn {nsk}{No-previous-block-for-last-pos}
		}
		{
			% exec last block id retrieval ~~~~~~~~~~~~~~~ <<<
			% block is already registered, so get prev
			\nsk__internal_get_nth_block_id:n{2}
			\tl_set:Nx \l_tmpa_tl { \g_nsk_block_last_requested_block_id }

			\str_if_in:NnTF \l_nsk_group_last_pos_tl {=}
			{
				% case (a) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
				% There's at least one '='
				% Next see if "of" is in there
				% e.g. "below=0cm"
				% => add " of <blockID>"
				\tl_set:Nx \l_nsk_group_pos_tl
				{
					\exp_not:V \l_nsk_group_last_pos_tl\space of~\exp_not:V \l_tmpa_tl
				}
			}
			{
				% case (b) ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
				% There's NO '=' in the user's string
				% e.g. "below right"
				% => produce "below right=of <blockID>"
				\tl_set:Nx \l_nsk_group_pos_tl
				{
					\exp_not:V \l_nsk_group_last_pos_tl =of~\exp_not:V \l_tmpa_tl
				}
			}
		}
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Alignment Processing for Groups
% Modifies anchor and position target based on align key and positioning direction
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__group_align_modify_pos:n #1
{
	% #1 = new anchor to append/replace in position string
	% Modifies \l_nsk_group_pos_tl to use the new target anchor

	\tl_if_blank:VF \l_nsk_group_pos_tl
	{
		% Check if pos contains "." (existing anchor specification)
		\str_if_in:VnTF \l_nsk_group_pos_tl {.}
		{
			% Replace existing anchor: find last "." and replace everything after
			% Split at " of " first
			\seq_set_split:NnV \l_tmpa_seq { ~of~ } \l_nsk_group_pos_tl
			\int_compare:nNnT { \seq_count:N \l_tmpa_seq } = {2}
			{
				\tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq {1} }
				\tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq {2} }
				% Find node name (before the dot)
				\seq_set_split:NnV \l_tmpb_seq {.} \l_tmpb_tl
				\tl_set:Nx \l_tmpc_tl { \seq_item:Nn \l_tmpb_seq {1} }
				% Rebuild with new anchor
				\tl_set:Nx \l_nsk_group_pos_tl
				{
					\l_tmpa_tl \c_space_tl of~ \l_tmpc_tl . #1
				}
			}
		}
		{
			% No existing anchor, append the new one
			\tl_put_right:Nn \l_nsk_group_pos_tl { . #1 }
		}
	}
}

\cs_new_protected_nopar:Npn \nsk__process_group_align:
{
	% Only process if align is set and not "none", and position is specified
	\str_if_eq:VnF \l_nsk_group_align_tl {none}
	{
		\tl_if_blank:VF \l_nsk_group_pos_tl
		{
			% Determine the positioning direction from the current anchor
			% The anchor tells us which direction we positioned from:
			% - north = we positioned below
			% - south = we positioned above
			% - west = we positioned right
			% - east = we positioned left

			\str_case:Vn \l_nsk_pos_align_tl
			{
				% Vertical positioning (below): horizontal alignment
				{north~}
				{
					\str_case:Vn \l_nsk_group_align_tl
					{
						{left}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {north~west}
							\nsk__group_align_modify_pos:n {south~west}
						}
						{right}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {north~east}
							\nsk__group_align_modify_pos:n {south~east}
						}
					}
				}
				% Vertical positioning (above): horizontal alignment
				{south~}
				{
					\str_case:Vn \l_nsk_group_align_tl
					{
						{left}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {south~west}
							\nsk__group_align_modify_pos:n {north~west}
						}
						{right}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {south~east}
							\nsk__group_align_modify_pos:n {north~east}
						}
					}
				}
				% Horizontal positioning (right of target): vertical alignment
				{west~}
				{
					\str_case:Vn \l_nsk_group_align_tl
					{
						{top}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {north~west}
							\nsk__group_align_modify_pos:n {north~east}
						}
						{bottom}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {south~west}
							\nsk__group_align_modify_pos:n {south~east}
						}
					}
				}
				% Horizontal positioning (left of target): vertical alignment
				{east~}
				{
					\str_case:Vn \l_nsk_group_align_tl
					{
						{top}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {north~east}
							\nsk__group_align_modify_pos:n {north~west}
						}
						{bottom}
						{
							\tl_set:Nn \l_nsk_pos_align_tl {south~east}
							\nsk__group_align_modify_pos:n {south~west}
						}
					}
				}
			}
		}
	}
}


\cs_new_protected_nopar:Npn \nsk__detect_anchor_pos:
{
	\nsk__group_parse_pos:

	% vertical  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	\tl_if_blank:VTF \l_nsk_group_pos_tl
	{}
	{
		\tl_if_blank:VT \l_nsk_pos_align_tl
		{
			\tl_if_blank:VF \l_nsk_group_ps_dira_tl
			{
				\str_case:Vn \l_nsk_group_ps_dira_tl {
					{above}{\tl_set:Nn \l_nsk_pos_align_tl {south~}}
						{below}{\tl_set:Nn \l_nsk_pos_align_tl {north~}}
						{right}{\tl_set:Nn \l_nsk_pos_align_tl {west~}}
						{left}{\tl_set:Nn \l_nsk_pos_align_tl {east~}}
				}
			}

			\tl_if_blank:VF \l_nsk_group_ps_dirb_tl
			{
				\str_case:Vn \l_nsk_group_ps_dirb_tl {
					{right}{\tl_put_right:Nn \l_nsk_pos_align_tl {west}}
						{left}{\tl_put_right:Nn \l_nsk_pos_align_tl {east}}
				}
			}
		}
	}
}


%-----------------------------------------------------------
% Group
% logical grouping
%-----------------------------------------------------------
\keys_define:nn {nsk / group}
{
	% bounds id ------------------------------------------------
	bounds-name .tl_set:N = \l_nsk_group_bounds_name_tl,
	bounds-name .initial:n = {__nsk_container_bounds},
	bounds-name .default:n = {__nsk_container_bounds},

	% natural positioning using positioning library
	pos .tl_set:N = \l_nsk_group_pos_tl,
	pos .initial:n = { },
	pos .default:n = { },

	last-pos .tl_set:N = \l_nsk_group_last_pos_tl,
	last-pos .initial:n = { },

	% pos-alignment (edge flush) ~~~~~~~~~~~~~~~~~ <<<
	anchor .tl_set:N = \l_nsk_pos_align_tl,
	anchor .default:n = { },
	anchor .initial:n = { },

	align .choice:,
	align / left .code:n = { \tl_set:Nn \l_nsk_group_align_tl { left } },
	align / right .code:n = { \tl_set:Nn \l_nsk_group_align_tl { right } },
	align / center .code:n = { \tl_set:Nn \l_nsk_group_align_tl { center } },
	align / top .code:n = { \tl_set:Nn \l_nsk_group_align_tl { top } },
	align / bottom .code:n = { \tl_set:Nn \l_nsk_group_align_tl { bottom } },
	align / none .code:n = { \tl_set:Nn \l_nsk_group_align_tl { none } },
	align .initial:n = {none},
	align .default:n = {none},

	shift-x .fp_set:N = \l_nsk_group_x_fp,
	shift-x .initial:n = {0},
	shift-x .default:n = {0},

	shift-y .fp_set:N = \l_nsk_group_y_fp,
	shift-y .initial:n = {0},
	shift-y .default:n = {0},


	rotate .fp_set:N = \l_nsk_group_rotate_fp,
	rotate .initial:n = {0},
	rotate .default:n = {0},

	scale .fp_set:N = \l_nsk_group_scale_fp,
	scale .initial:n = {1},
	scale .default:n = {1},

	% Scope first child positioning within group
	scope-first-pos .bool_set:N = \l_nsk_group_scope_first_pos_bool,
	scope-first-pos .initial:n = {true},
	scope-first-pos .default:n = {true},

	% forward unknown props to scope
	unknown .code:n =
		{
			% Store unknown key in the property list, using the content of \l_keys_key_tl as a string
			\prop_put:Nxx \l_nsk_group_unknown_prop
			{ \tl_use:N \l_keys_key_tl }
			{ #1 }
		},
}

%-----------------------------------------------------------------
% () Internal: build the final TikZ style as a comma-separated list
%    We'll store it in \l_tmpa_tl.
%-----------------------------------------------------------------

\cs_new_protected_nopar:Npn \nsk__build_group_style:
{
	% styles
	\tl_clear_new:N \l_tmpa_tl

	\tl_put_right:Nx \l_tmpa_tl
	{local~bounding~box=\l_nsk_group_bounds_name_tl, }

	\tl_if_blank:VF \l_nsk_group_pos_tl
	{
		\tl_put_right:Nx \l_tmpa_tl
		{ shift={(\l_nsk_group_refnode_id_tl)}, }

	}

	\tl_if_blank:VF \l_nsk_pos_align_tl
	{
		\tl_put_right:Nx \l_tmpa_tl
		{anchor={\l_nsk_pos_align_tl}, }

		% use pic workaround / wait for buffer write
		\tl_put_right:Nn \l_tmpa_tl
		{scope~anchor, }
	}


	% rotate=...
	\tl_put_right:Nx \l_tmpa_tl { rotate=\fp_use:N \l_nsk_group_rotate_fp, }

	% scale=...
	\tl_if_eq:nnF {\fp_to_decimal:N \l_nsk_group_scale_fp}{1.0}
	{ \tl_put_right:Nx \l_tmpa_tl { scale=\fp_use:N \l_nsk_group_scale_fp, } }

	% forward unknown keys as-is
	\prop_map_inline:Nn \l_nsk_group_unknown_prop
	{
		\tl_put_right:Nn \l_tmpa_tl
		{
			##1 = ##2,
		}
	}

}

%-----------------------------------------------------------------
% 4) Internal: draw the scope with the built style
%    #1 -> the style token list (passed by value)
%    #2 -> user content
%-----------------------------------------------------------------
\cs_new_protected:Npn \nsk__draw_group_scope_aux:nnn #1 #2 #3
{
	% phantom node ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	\tl_if_blank:VF \l_nsk_group_pos_tl
	{
		\node[
			#1,
			draw=none,
			fill=none,
			name=\l_nsk_group_refnode_id_tl,
			anchor=center
		] {};
	}


	% actual draw ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	\begin{scope}[#2]
		\pgftransformshift{
			\pgfpoint{\fp_use:N \l_nsk_group_x_fp}{\fp_use:N \l_nsk_group_y_fp}
		}
		#3
	\end{scope}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Variant Generation :V
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_generate_variant:Nn \nsk__draw_group_scope_aux:nnn { VVn }

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Public Interface
% - (user-facing)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\NewDocumentCommand \nskGroup { sO{} }
{
	\IfBooleanTF{#1}
	{
		% Starred form: auto-expand keys
		\edef\l_tmpa_tl{#2}
		\expandafter\nskGroupR\expandafter[\l_tmpa_tl]
	}
	{
		\nskGroupR[#2]
	}
}

\NewDocumentCommand \nskGroupR { O{} +m }
{
	% Push current state to stack before starting a new group
	\nsk__group_push_to_stack:

	% Create a unique bounds name for this nesting level, if not explicitly provided
	\tl_if_blank:VT \l_nsk_group_bounds_name_tl {
		\tl_set:Nx \l_nsk_group_bounds_name_tl {__nsk_group_bounds_\int_use:N \g_nsk_group_stack_level_int}
	}

	\group_begin:

	\keys_set:nn { nsk / group } {#1}

	\nsk__process_last_pos_for_group:

	% Auto-scope first pos if group has last-pos
	\bool_if:NT \l_nsk_group_scope_first_pos_bool
	{
		\tl_if_blank:VF \l_nsk_group_last_pos_tl
		{
			\int_gset:Nn \g_nsk_block_skip_pos_counter_int {0}
		}
	}

	% maybe detect anchor pos
	\nsk__detect_anchor_pos:

	% --- Process alignment (modifies anchor and pos based on align key)
	\nsk__process_group_align:

	% Build a comma-separated style in \l_tmpa_tl
	\nsk__build_group_style:

	% draw
	\nsk__draw_group_scope_aux:VVn \l_nsk_group_pos_tl \l_tmpa_tl {#2}

	\group_end:

	% Restore previous state from stack when done
	\nsk__group_pop_from_stack:
}

\NewDocumentCommand \nskOnlayer { m +m }
{
	\begin{pgfonlayer}{#1}
		#2
	\end{pgfonlayer}
}

\NewDocumentCommand \nskOnbg { +m }
{
	\nskOnlayer{background}{#1}
}

\NewDocumentCommand \nskOnfg { +m }
{
	\nskOnlayer{foreground}{#1}
}


