% Keys for wrap under options
\keys_define:nn { nsk / wrap }
{
	under .code:n  = {
			\tl_set:Nn \l__nsk_wrap_ref_tl {#1}
			\tl_set:Nn \l__nsk_wrap_direction_tl {below}
			\tl_set:Nn \l__nsk_wrap_anchor_tl {north}
		},
	under .initial:n = {},

	over .code:n  = {
			\tl_set:Nn \l__nsk_wrap_ref_tl {#1}
			\tl_set:Nn \l__nsk_wrap_direction_tl {above}
			\tl_set:Nn \l__nsk_wrap_anchor_tl {south}
		},
	over .initial:n = {},

	target .tl_set:N = \l__nsk_wrap_ref_tl,
	target .initial:n = {},

	direction .tl_set:N = \l__nsk_wrap_direction_tl,
	direction .initial:n = {},

	anchor .tl_set:N = \l__nsk_wrap_anchor_tl,
	anchor .initial:n = {},


	shift-x .dim_set:N = \l__nsk_wrap_shift_x_dim,
	shift-x .initial:n = 0cm,
	shift-x .default:n = 0cm,
	shift-y .dim_set:N = \l__nsk_wrap_shift_y_dim,
	shift-y .initial:n = 0cm,
	shift-y .default:n = 0cm,
}

% TODO: add support for x and y block-distance
\NewDocumentCommand {\nskWrap} { t! O{} } {
	% Process keys
	\keys_set:nn { nsk / wrap } {#2}

	\IfBooleanTF{#1}{
		\nskMark[pos={
					\l__nsk_wrap_direction_tl\space right=\tl_use:N \g__nsk_style_figure_block_distance_tl~and~0cm~of~\tl_use:N \l__nsk_wrap_ref_tl,
				}, shift-x=\dim_use:N \l__nsk_wrap_shift_x_dim,
			, shift-y=\dim_use:N \l__nsk_wrap_shift_y_dim
		]

		% set wrap flag
		\bool_gset_true:N \g_nsk_wrap_right_bool
	}{
		\nskMark[pos={\l__nsk_wrap_direction_tl\space left=\tl_use:N \g__nsk_style_figure_block_distance_tl~and~0cm~of~\tl_use:N \l__nsk_wrap_ref_tl,
				}, shift-x=\dim_use:N \l__nsk_wrap_shift_x_dim,
			, shift-y=\dim_use:N \l__nsk_wrap_shift_y_dim
		]


		% set wrap flag
		\bool_gset_true:N \g_nsk_wrap_left_bool
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Uniform Border Scaling
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__maybe_uniform_border_scaling:
{
	% Only scale if border radius was manually set and scaling is enabled
	\bool_if:nT { \l_nsk_block_border_radius_mset_bool && \l_nsk_block_border_radius_scale_bool }
	{
		% Calculate scaling factors based on width and height increase from defaults
		\fp_set:Nn \l_tmpa_fp { \l_nsk_block_width_dim / \g__nsk_style_block_width_dim }
		\fp_set:Nn \l_tmpb_fp { \l_nsk_block_height_dim / \g__nsk_style_block_height_dim }

		% Use geometric mean for balanced scaling proportional to area
		\fp_set:Nn \l_tmpa_fp { sqrt(\l_tmpa_fp * \l_tmpb_fp) }

		% Scale the border radius by this factor
		\dim_set:Nn \l_nsk_block_border_radius_dim { \fp_to_dim:n { \l_nsk_block_border_radius_dim * \l_tmpa_fp } }

		% Clamp border radius to at most half the minimum dimension
		\dim_set:Nn \l_tmpb_dim { \dim_min:nn { \l_nsk_block_width_dim } { \l_nsk_block_height_dim } / 2 }
		\dim_compare:nNnT { \l_nsk_block_border_radius_dim } > { \l_tmpb_dim }
		{
			\dim_set_eq:NN \l_nsk_block_border_radius_dim \l_tmpb_dim
		}

		% Also scale per-corner radii if they were manually set
		\bool_if:NT \l_nsk_block_border_radius_nw_mset_bool
		{
			\dim_set:Nn \l_nsk_block_border_radius_nw_dim { \fp_to_dim:n { \l_nsk_block_border_radius_nw_dim * \l_tmpa_fp } }
			\dim_compare:nNnT { \l_nsk_block_border_radius_nw_dim } > { \l_tmpb_dim }
			{
				\dim_set_eq:NN \l_nsk_block_border_radius_nw_dim \l_tmpb_dim
			}
		}
		\bool_if:NT \l_nsk_block_border_radius_ne_mset_bool
		{
			\dim_set:Nn \l_nsk_block_border_radius_ne_dim { \fp_to_dim:n { \l_nsk_block_border_radius_ne_dim * \l_tmpa_fp } }
			\dim_compare:nNnT { \l_nsk_block_border_radius_ne_dim } > { \l_tmpb_dim }
			{
				\dim_set_eq:NN \l_nsk_block_border_radius_ne_dim \l_tmpb_dim
			}
		}
		\bool_if:NT \l_nsk_block_border_radius_sw_mset_bool
		{
			\dim_set:Nn \l_nsk_block_border_radius_sw_dim { \fp_to_dim:n { \l_nsk_block_border_radius_sw_dim * \l_tmpa_fp } }
			\dim_compare:nNnT { \l_nsk_block_border_radius_sw_dim } > { \l_tmpb_dim }
			{
				\dim_set_eq:NN \l_nsk_block_border_radius_sw_dim \l_tmpb_dim
			}
		}
		\bool_if:NT \l_nsk_block_border_radius_se_mset_bool
		{
			\dim_set:Nn \l_nsk_block_border_radius_se_dim { \fp_to_dim:n { \l_nsk_block_border_radius_se_dim * \l_tmpa_fp } }
			\dim_compare:nNnT { \l_nsk_block_border_radius_se_dim } > { \l_tmpb_dim }
			{
				\dim_set_eq:NN \l_nsk_block_border_radius_se_dim \l_tmpb_dim
			}
		}
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Per-corner border radius mode detection
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__determine_percorner_mode:
{
	% Reset per-corner mode
	\bool_set_false:N \l_nsk_block_percorner_mode_bool

	% Check if any corner was explicitly set
	\bool_if:nT {
		\l_nsk_block_border_radius_nw_mset_bool ||
		\l_nsk_block_border_radius_ne_mset_bool ||
		\l_nsk_block_border_radius_sw_mset_bool ||
		\l_nsk_block_border_radius_se_mset_bool
	}
	{
		% Enable per-corner mode
		\bool_set_true:N \l_nsk_block_percorner_mode_bool

		% Resolve unset corners to main border-radius
		\bool_if:NF \l_nsk_block_border_radius_nw_mset_bool
		{
			\dim_set_eq:NN \l_nsk_block_border_radius_nw_dim \l_nsk_block_border_radius_dim
		}
		\bool_if:NF \l_nsk_block_border_radius_ne_mset_bool
		{
			\dim_set_eq:NN \l_nsk_block_border_radius_ne_dim \l_nsk_block_border_radius_dim
		}
		\bool_if:NF \l_nsk_block_border_radius_sw_mset_bool
		{
			\dim_set_eq:NN \l_nsk_block_border_radius_sw_dim \l_nsk_block_border_radius_dim
		}
		\bool_if:NF \l_nsk_block_border_radius_se_mset_bool
		{
			\dim_set_eq:NN \l_nsk_block_border_radius_se_dim \l_nsk_block_border_radius_dim
		}
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Custom rounded rectangle drawing with per-corner radii
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__draw_percorner_rounded_rect:
{
	% Get node anchors for positioning, inset by half border size so stroke doesn't extend beyond node
	\path ([shift={(\l_nsk_block_border_size_dim/2, -\l_nsk_block_border_size_dim/2)}]\l_nsk_block_id_tl.north~west) coordinate (nsk@nw);
	\path ([shift={(-\l_nsk_block_border_size_dim/2, -\l_nsk_block_border_size_dim/2)}]\l_nsk_block_id_tl.north~east) coordinate (nsk@ne);
	\path ([shift={(\l_nsk_block_border_size_dim/2, \l_nsk_block_border_size_dim/2)}]\l_nsk_block_id_tl.south~west) coordinate (nsk@sw);
	\path ([shift={(-\l_nsk_block_border_size_dim/2, \l_nsk_block_border_size_dim/2)}]\l_nsk_block_id_tl.south~east) coordinate (nsk@se);

	% Build the path token list
	\tl_clear_new:N \l__nsk_percorner_path_tl

	% Start at NW corner, offset by radius along top edge
	\tl_put_right:Nx \l__nsk_percorner_path_tl
		{ ([xshift=\dim_use:N \l_nsk_block_border_radius_nw_dim]nsk@nw) }

	% Top edge to NE
	\tl_put_right:Nx \l__nsk_percorner_path_tl
		{ -- ([xshift=-\dim_use:N \l_nsk_block_border_radius_ne_dim]nsk@ne) }

	% NE corner arc (or sharp corner if radius is 0)
	\dim_compare:nNnTF {\l_nsk_block_border_radius_ne_dim} > {0pt}
	{
		\tl_put_right:Nx \l__nsk_percorner_path_tl
			{ arc[start~angle=90, end~angle=0, radius=\dim_use:N \l_nsk_block_border_radius_ne_dim] }
	}
	{
		\tl_put_right:Nn \l__nsk_percorner_path_tl { -- (nsk@ne) }
	}

	% Right edge to SE
	\tl_put_right:Nx \l__nsk_percorner_path_tl
		{ -- ([yshift=\dim_use:N \l_nsk_block_border_radius_se_dim]nsk@se) }

	% SE corner arc (or sharp corner if radius is 0)
	\dim_compare:nNnTF {\l_nsk_block_border_radius_se_dim} > {0pt}
	{
		\tl_put_right:Nx \l__nsk_percorner_path_tl
			{ arc[start~angle=0, end~angle=-90, radius=\dim_use:N \l_nsk_block_border_radius_se_dim] }
	}
	{
		\tl_put_right:Nn \l__nsk_percorner_path_tl { -- (nsk@se) }
	}

	% Bottom edge to SW
	\tl_put_right:Nx \l__nsk_percorner_path_tl
		{ -- ([xshift=\dim_use:N \l_nsk_block_border_radius_sw_dim]nsk@sw) }

	% SW corner arc (or sharp corner if radius is 0)
	\dim_compare:nNnTF {\l_nsk_block_border_radius_sw_dim} > {0pt}
	{
		\tl_put_right:Nx \l__nsk_percorner_path_tl
			{ arc[start~angle=-90, end~angle=-180, radius=\dim_use:N \l_nsk_block_border_radius_sw_dim] }
	}
	{
		\tl_put_right:Nn \l__nsk_percorner_path_tl { -- (nsk@sw) }
	}

	% Left edge to NW
	\tl_put_right:Nx \l__nsk_percorner_path_tl
		{ -- ([yshift=-\dim_use:N \l_nsk_block_border_radius_nw_dim]nsk@nw) }

	% NW corner arc (or sharp corner if radius is 0)
	\dim_compare:nNnTF {\l_nsk_block_border_radius_nw_dim} > {0pt}
	{
		\tl_put_right:Nx \l__nsk_percorner_path_tl
			{ arc[start~angle=180, end~angle=90, radius=\dim_use:N \l_nsk_block_border_radius_nw_dim] }
	}
	{
		\tl_put_right:Nn \l__nsk_percorner_path_tl { -- (nsk@nw) }
	}

	% Close the path
	\tl_put_right:Nn \l__nsk_percorner_path_tl { -- cycle }

	% Draw the path using tl_use for expansion
	\tl_if_eq:NnTF \l_nsk_block_border_type_tl { none }
	{
		\draw [
			fill=\l_nsk_block_fill_tl,
			draw=none,
			line~width=\l_nsk_block_border_size_dim,
			opacity=\l_nsk_block_opacity_tl,
		] \tl_use:N \l__nsk_percorner_path_tl ;
	}
	{
		\draw [
			fill=\l_nsk_block_fill_tl,
			draw=\l_nsk_block_border_color_tl,
			line~width=\l_nsk_block_border_size_dim,
			opacity=\l_nsk_block_opacity_tl,
			\l_nsk_block_border_type_tl
		] \tl_use:N \l__nsk_percorner_path_tl ;
	}
}

