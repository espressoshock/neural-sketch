% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Unified Block Type Parsing
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
% Temporary variables for parsed type components
\tl_new:N \l__nsk_parsed_base_type_tl
\tl_new:N \l__nsk_parsed_args_tl
\seq_new:N \l__nsk_parsed_args_seq
\seq_new:N \l__nsk_parse_result_seq

% Append to extra_style with proper comma handling
\cs_new_protected:Npn \nsk__append_extra_style:n #1
{
    \tl_if_empty:NTF \l_nsk_block_extra_style_tl
    { \tl_set:Nn \l_nsk_block_extra_style_tl { #1 } }
    { \tl_put_right:Nn \l_nsk_block_extra_style_tl { ,~ #1 } }
}
\cs_generate_variant:Nn \nsk__append_extra_style:n { x, V }

% Standard shape handler: #1 = tikz-shape, #2 = tikz-option-key, #3 = default
\cs_new_protected:Npn \nsk__apply_shape:nnn #1 #2 #3
{
    \tl_set:Nn \l_nsk_block_type_tl { #1 }
    \tl_if_empty:NTF \l__nsk_parsed_args_tl
    { \nsk__append_extra_style:n { #2 = #3 } }
    { \nsk__append_extra_style:x { #2 = \l__nsk_parsed_args_tl } }
}

% Squircle handler
\cs_new_protected:Npn \nsk__handle_squircle_args:
{
    \tl_set:Nn \l_nsk_block_type_tl { superellipse }

    % Defaults
    \tl_set:Nn \l_nsk_block_squircle_ex_tl { 4 }
    \tl_set:Nn \l_nsk_block_squircle_ey_tl { 4 }
    \tl_set:Nn \l_nsk_block_squircle_step_tl { 5 }

    \tl_if_empty:NF \l__nsk_parsed_args_tl
    {
        \seq_set_split:NnV \l__nsk_parsed_args_seq { , } \l__nsk_parsed_args_tl
        \int_compare:nNnTF { \seq_count:N \l__nsk_parsed_args_seq } > { 1 }
        {
            \seq_pop_left:NNT \l__nsk_parsed_args_seq \l_tmpa_tl
                { \tl_set:NV \l_nsk_block_squircle_ex_tl \l_tmpa_tl }
            \seq_pop_left:NNT \l__nsk_parsed_args_seq \l_tmpa_tl
                { \tl_set:NV \l_nsk_block_squircle_ey_tl \l_tmpa_tl }
            \seq_pop_left:NNT \l__nsk_parsed_args_seq \l_tmpa_tl
                { \tl_set:NV \l_nsk_block_squircle_step_tl \l_tmpa_tl }
        }
        {
            \seq_pop_left:NNT \l__nsk_parsed_args_seq \l_tmpa_tl
            {
                \tl_set:NV \l_nsk_block_squircle_ex_tl \l_tmpa_tl
                \tl_set_eq:NN \l_nsk_block_squircle_ey_tl \l_nsk_block_squircle_ex_tl
            }
        }
    }

    \nsk__append_extra_style:x { superellipse~x~exponent = \l_nsk_block_squircle_ex_tl }
    \nsk__append_extra_style:x { superellipse~y~exponent = \l_nsk_block_squircle_ey_tl }
    \nsk__append_extra_style:x { superellipse~step = \l_nsk_block_squircle_step_tl }
    \dim_set:Nn \l_nsk_block_border_radius_dim { 0mm }
    \dim_set:Nn \l_nsk_block_embed_border_radius_dim { 0mm }
}

% Text/Icon handler
\cs_new_protected:Npn \nsk__handle_text_type:
{
    \tl_set:Nn \l_nsk_block_type_tl { rectangle }
    \tl_set:Nn \l_nsk_block_border_type_tl { draw=none }
    \bool_set_false:N \l_nsk_block_shadow_bool
    \tl_set:Nn \l_nsk_block_fill_tl { none }
    \dim_set:Nn \l_nsk_block_width_dim { 0cm }
    \dim_set:Nn \l_nsk_block_padding_x_dim { 0mm }
}

% Unified parse and dispatch function
\cs_new_protected:Npn \nsk__parse_and_dispatch_type:
{
    % Single regex: ^(\w+)(?:\[([^\]]*)\])?
    \regex_extract_once:nVNTF
        { ^(\w+)(?:\[([^\]]*)\])? }
        \l_nsk_block_type_tl
        \l__nsk_parse_result_seq
    {
        \tl_set:Nx \l__nsk_parsed_base_type_tl { \seq_item:Nn \l__nsk_parse_result_seq {2} }
        \tl_set:Nx \l__nsk_parsed_args_tl { \seq_item:Nn \l__nsk_parse_result_seq {3} }

        % Dispatch with early exit
        \str_case:VnF \l__nsk_parsed_base_type_tl
        {
            { polygon }  { \nsk__apply_shape:nnn { regular~polygon } { regular~polygon~sides } { 5 } }
            { star }     { \nsk__apply_shape:nnn { star } { star~points } { 5 } }
            { rrect }    { \nsk__apply_shape:nnn { rounded~rectangle } { rounded~rectangle~arc~length } { 90 } }
            { crect }    { \nsk__apply_shape:nnn { chamfered~rectangle } { chamfered~rectangle~xsep } { 3mm } }
            { squircle } { \nsk__handle_squircle_args: }
            { text }     { \nsk__handle_text_type: }
            { icon }     { \nsk__handle_text_type: }
        }
        { } % No match - type passes through unchanged
    }
    { } % No regex match - type used as-is
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Public Interface
% - (user-facing)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\NewDocumentCommand \nskBlock { sO{} }
{
	\IfBooleanTF{#1}
	{
		% Starred form: auto-expand keys
		\protected@edef\l_tmpa_tl{#2}
		\expandafter\nskBlockR\expandafter[\l_tmpa_tl]
	}
	{
		\nskBlockR[#2]
	}
}

\NewDocumentCommand \nskBlockR { O{} }
{
	\group_begin:

	% Initialize local settings from global style defaults
	\bool_set_eq:NN \l_nsk_block_border_radius_scale_bool \g__nsk_style_block_border_radius_scale_bool
	\tl_set_eq:NN \l_nsk_block_type_tl \g__nsk_style_block_type_tl

	% # 1 -> k=v list
	\keys_set:nn {nsk / block } {#1}

	% possibly autogenerate the id
	\nsk__maybe_set_id:

	\bool_if:NT \l_nsk_block_store_style_bool
	{
		% parse and remove id
		\prop_clear:N \l_tmpa_prop
		\prop_set_from_keyval:Nn \l_tmpa_prop {#1}
		\prop_remove:Nn \l_tmpa_prop {id}
		% remove any pos
		\prop_remove:Nn \l_tmpa_prop {pos}
		\prop_remove:Nn \l_tmpa_prop {last-pos}
		\prop_remove:Nn \l_tmpa_prop {last-pos-s}
		\prop_remove:Nn \l_tmpa_prop {x}
		\prop_remove:Nn \l_tmpa_prop {y}
		\prop_remove:Nn \l_tmpa_prop {border-type}
		\prop_remove:Nn \l_tmpa_prop {text-north}
		\prop_remove:Nn \l_tmpa_prop {text-south}
		\prop_remove:Nn \l_tmpa_prop {text-east}
		\prop_remove:Nn \l_tmpa_prop {text-west}

		% store id
		\prop_gput:NVx \g_nsk_block_stored_style_prop \l_nsk_block_id_tl {\prop_to_keyval:N \l_tmpa_prop}
	}
	% if grid-on
	\tl_if_blank:VF \l_nsk_block_grid_on_tl
	{
		\prop_get:NVN \g_nsk_block_stored_style_prop \l_nsk_block_grid_on_tl \l_tmps_tl
		\keys_set:nx {nsk / block } {\l_tmps_tl}
		% snap to->
		\tl_set:Nx \l_nsk_block_pos_tl {at=(\l_nsk_block_grid_on_tl)}
		\tl_set:Nx \l_nsk_block_anchor_tl {center}
	}


	% Parse block type and dispatch to appropriate handler
	\nsk__parse_and_dispatch_type:

	% process last-pos -> set cpos if neeeded
	% if last-pos-s is given, use it (without error); otherwise use last-pos
	\tl_if_blank:VTF \l_nsk_block_last_pos_s_tl
	{ \nsk__process_last_pos: }
	{ \nsk__process_last_pos_s: }

	% process alignment (flushing) / only works if pos is set
	\tl_if_blank:VF \l_nsk_block_pos_tl
	{ \nsk__process_align: }

	\nsk__block_debug:

	% actually draw the block
	\nsk__draw_block:

	% store id in history (skip if in measurement mode)
	\bool_if:NF \g__nsk_measurement_mode_bool
	{
		\nsk__store_block_in_history:
	}


	\group_end:
}

