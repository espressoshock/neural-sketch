% \title{neural-sketch.sty (main code)}
% \author{Vincenzo Buono}
% \date{\today}
% \maketitle

% \StopEventually{}

% implementation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
%<*package>
%    \begin{macrocode}

% external ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\RequirePackage{tikz}
\RequirePackage{expl3}
\usetikzlibrary{
	calc, fit,
	shapes.geometric,
	shapes.symbols,
	shapes.misc,
	arrows.meta,
	positioning,
	arrows.meta,
	shadows,
	shadings,
	patterns, patterns.meta,
	backgrounds,
	tikzmark,
	math,
  ext.shapes.superellipse
}


\ExplSyntaxOn

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Helper: set dimension with optional unit (defaults to cm like TikZ)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected:Npn \__nsk_set_coord_dim:Nn #1 #2
{
	\tl_if_in:nnTF {#2} {pt}
	{ \dim_set:Nn #1 {#2} }
	{
		\tl_if_in:nnTF {#2} {cm}
		{ \dim_set:Nn #1 {#2} }
		{
			\tl_if_in:nnTF {#2} {mm}
			{ \dim_set:Nn #1 {#2} }
			{
				\tl_if_in:nnTF {#2} {in}
				{ \dim_set:Nn #1 {#2} }
				{
					\tl_if_in:nnTF {#2} {em}
					{ \dim_set:Nn #1 {#2} }
					{
						\tl_if_in:nnTF {#2} {ex}
						{ \dim_set:Nn #1 {#2} }
						{ \dim_set:Nn #1 {#2 cm} }
					}
				}
			}
		}
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Pkg opts
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prop_new:N \l__nsk_pkgopts_opts_prop
\keys_define:nn { nsk / pkgopts }
{
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Dark mode
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	dark-mode .bool_gset:N = \g__nsk_dark_mode_bool,
	dark-mode .initial:n   = {false},
	dark-mode .default:n   = {false},

	unknown .code:n =
		{
			\prop_put:Nxx \l__nsk_pkgopts_opts_prop
			{ \tl_use:N \l_keys_key_tl }
			{ #1 }
		},

}
\ProcessKeysOptions { nsk / pkgopts }


% prop->tl
\tl_new:N \l__nsk_pkgopts_opts_tl
\tl_clear:N \l__nsk_pkgopts_opts_tl

\prop_map_inline:Nn \l__nsk_pkgopts_opts_prop
{
	\tl_put_right:Nx \l__nsk_pkgopts_opts_tl
	{
		#1 = {#2},
	}
}


% dark-mode ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\bool_if:NTF \g__nsk_dark_mode_bool
{
\definecolor{ c__nsk_dark_bg_clr }      {HTML}{1d2021}
\definecolor{ c__nsk_principal } {HTML}{ebdbb2}
\pagecolor{c__nsk_dark_bg_clr}
\colorlet{nskBg}{c__nsk_dark_bg_clr}
\colorlet{nskFg}{c__nsk_principal}
\colorlet{nskDarker}{c__nsk_dark_bg_clr}
\colorlet{nskLighter}{c__nsk_principal}
\tikzset{
every~node/.append~style={text=c__nsk_principal},
% every~path/.append~style={draw=red}
}
}
{
\definecolor{ c__nsk_principal } {HTML}{000000}
\pagecolor{white}
\colorlet{nskBg}{white}
\colorlet{nskFg}{black}
\colorlet{nskDarker}{nskFg}
\colorlet{nskLighter}{nskBg}
}

\ExplSyntaxOff

% internal ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\RequirePackage{neural-sketch-colors}
\RequirePackage{neural-sketch-styles}
\RequirePackage{neural-sketch-loader}

\ExplSyntaxOn

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Pass-through nsk / style
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\keys_set:nx { nsk / style } { \l__nsk_pkgopts_opts_tl }

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global Stored Styles
% to reuse-previouse elements styles
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prop_new:N \g_nsk_block_stored_style_prop

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global props -
% to track auto-increment counters
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prop_new:N \g_nsk_block_counters_prop
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global seq -
% to track block-id reference counters
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\seq_new:N \g_nsk_block_id_history_seq
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global flag -
% to track wrapping
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\bool_new:N \g_nsk_wrap_right_bool
\bool_new:N \g_nsk_wrap_left_bool

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Grid dims
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\dim_new:N \l_nsk_block_grid_stepx_dim
\dim_new:N \l_nsk_block_grid_stepy_dim
\int_new:N \l_nsk_grid_cols_int
\int_new:N \l_nsk_grid_rows_int
\int_new:N \l_nsk_grid_max_row_int
\int_new:N \l_nsk_grid_max_col_int
\dim_new:N \g_nsk_cell_width_dim
\dim_new:N \g_nsk_cell_height_dim
\def\nskCellWidth{\g_nsk_cell_width_dim}
\def\nskCellHeight{\g_nsk_cell_height_dim}
\def\nskBorderSize{\g__nsk_style_block_border_size_dim}
\int_new:N \l_nsk_block_grid_segx_int    % segment count X (0 = use spacing)
\int_new:N \l_nsk_block_grid_segy_int    % segment count Y (0 = use spacing)
\dim_new:N \l_nsk_block_border_radius_dim

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Per-corner border radius dimensions
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\dim_new:N \l_nsk_block_border_radius_nw_dim
\dim_new:N \l_nsk_block_border_radius_ne_dim
\dim_new:N \l_nsk_block_border_radius_sw_dim
\dim_new:N \l_nsk_block_border_radius_se_dim

% Tracking booleans for per-corner border radius
\bool_new:N \l_nsk_block_border_radius_nw_mset_bool
\bool_new:N \l_nsk_block_border_radius_ne_mset_bool
\bool_new:N \l_nsk_block_border_radius_sw_mset_bool
\bool_new:N \l_nsk_block_border_radius_se_mset_bool
\bool_new:N \l_nsk_block_percorner_mode_bool

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Block position dims
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\dim_new:N \l_nsk_block_x_dim
\dim_new:N \l_nsk_block_y_dim

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Perspective block corner dims (for trapezoid rendering)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\dim_new:N \l__nsk_sw_x_dim  \dim_new:N \l__nsk_sw_y_dim
\dim_new:N \l__nsk_se_x_dim  \dim_new:N \l__nsk_se_y_dim
\dim_new:N \l__nsk_ne_x_dim  \dim_new:N \l__nsk_ne_y_dim
\dim_new:N \l__nsk_nw_x_dim  \dim_new:N \l__nsk_nw_y_dim

% Additional perspective dims for shape renderers
\dim_new:N \l__nsk_n_x_dim   \dim_new:N \l__nsk_n_y_dim   % diamond north
\dim_new:N \l__nsk_e_x_dim   \dim_new:N \l__nsk_e_y_dim   % diamond east
\dim_new:N \l__nsk_s_x_dim   \dim_new:N \l__nsk_s_y_dim   % diamond south
\dim_new:N \l__nsk_w_x_dim   \dim_new:N \l__nsk_w_y_dim   % diamond west
\dim_new:N \l__nsk_persp_radius_dim                        % polygon/star radius
\dim_new:N \l__nsk_persp_inner_radius_dim                  % star inner radius
\dim_new:N \l__nsk_persp_outer_radius_dim                  % star outer radius
\dim_new:N \l__nsk_persp_r_dim                             % current radius
\tl_new:N  \l__nsk_persp_path_tl                           % path accumulator
\int_new:N \l__nsk_persp_sides_int                         % polygon sides / star points
\dim_new:N \l__nsk_persp_expand_dim                        % expansion for outer border
\dim_new:N \l__nsk_saved_width_dim                         % saved width for expansion
\dim_new:N \l__nsk_saved_height_dim                        % saved height for expansion

% Additional temp dims (l_tmpc_dim and l_tmpd_dim are not standard)
\dim_new:N \l__nsk_tmpc_dim
\dim_new:N \l__nsk_tmpd_dim

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global counter -
% to track skipping pos (1=normal, 0=skip first last-pos in scope)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\int_new:N \g_nsk_block_skip_pos_counter_int
\int_gset:Nn \g_nsk_block_skip_pos_counter_int {1}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Main nsk / Block Primitive
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\keys_define:nn {nsk / block}
{
	% block type ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	type .code:n =
		{
			% \bool_lazy_or:nnTF
			% { \str_if_eq_p:nn {#1}{text} }
			% { \str_if_eq_p:nn {#1}{icon} }
			% {
			% 	\tl_set:Nn \l_nsk_block_type_tl {rectangle}
			% 	\tl_set:Nn \l_nsk_block_border_type_tl {draw=none}
			% 	\bool_set_false:N \l_nsk_block_shadow_bool
			% 	\tl_set:Nn \l_nsk_block_fill_tl {none}
			% 	% auto width
			% 	\dim_set:Nn \l_nsk_block_width_dim {0cm}
			% 	\dim_set:Nn \l_nsk_block_padding_x_dim {0mm}
			% }
			% {
			% 	\tl_set:Nn \l_nsk_block_type_tl {#1}
			% }
      \tl_set:Nn \l_nsk_block_type_tl {#1}
		},
	type .initial:n = {rectangle},
	type .default:n = {rectangle},

	% grid ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	grid .code:n = {
			\tl_set:Nn \l_nsk_block_grid_args_tl {#1}
			\tl_if_blank:VF \l_nsk_block_grid_args_tl {
				\seq_set_split:Nnn \l_args_seq {,} {#1}

				% Reset segment counts
				\int_zero:N \l_nsk_block_grid_segx_int
				\int_zero:N \l_nsk_block_grid_segy_int

				% Parse first argument (X)
				\seq_pop_left:NNT \l_args_seq \l_tmpa_tl {
					\__nsk_parse_grid_value:NNN \l_tmpa_tl
						\l_nsk_block_grid_stepx_dim \l_nsk_block_grid_segx_int
				}

				% Parse second argument (Y), default to X value if missing
				\seq_pop_left:NNTF \l_args_seq \l_tmpa_tl {
					\__nsk_parse_grid_value:NNN \l_tmpa_tl
						\l_nsk_block_grid_stepy_dim \l_nsk_block_grid_segy_int
				}{
					% Copy X to Y
					\dim_set_eq:NN \l_nsk_block_grid_stepy_dim \l_nsk_block_grid_stepx_dim
					\int_set_eq:NN \l_nsk_block_grid_segy_int \l_nsk_block_grid_segx_int
				}

				% set some styles
				\bool_set_false:N \l_nsk_block_shadow_bool
				\tl_set:Nn \l_nsk_block_fill_tl {none}
			}
		},
	grid .default:n = {},
	grid .initial:n = {},

	grid-on .tl_set:N = \l_nsk_block_grid_on_tl,
	grid-on .default:n = {},
	grid-on .initial:n = {},

	grid-line-size-x .dim_set:N = \l_nsk_block_grid_sizex_dim,
	grid-line-size-x .default:n = {.4mm},
	grid-line-size-x .initial:n = {.4mm},

	grid-line-size-y .dim_set:N = \l_nsk_block_grid_sizey_dim,
	grid-line-size-y .default:n = {.4mm},
	grid-line-size-y .initial:n = {.4mm},

	grid-line-size .code:n = {
			% \tl_set:Nn \l_nsk_block_grid_size_args_tl {#1}
			\seq_set_split:Nnn \l_args_seq {,} {#1}

			% set args -> [sizex], [sizey]
			\seq_pop_left:NNT \l_args_seq \l_tmpa_tl { \dim_set:Nn \l_nsk_block_grid_sizex_dim {\l_tmpa_tl} }
			\seq_pop_left:NNTF \l_args_seq \l_tmpa_tl
			{\dim_set:Nn \l_nsk_block_grid_sizey_dim {\l_tmpa_tl}}
			{\dim_set_eq:NN \l_nsk_block_grid_sizey_dim \l_nsk_block_grid_sizex_dim}
		},


	grid-outer-border .bool_set:N = \l_nsk_block_grid_outerb_tl,
	grid-outer-border .default:n = {true},
	grid-outer-border .initial:n = {true},

	grid-refs .bool_set:N = \l_nsk_block_grid_refs_bool,
	grid-refs .default:n = {true},
	grid-refs .initial:n = {false},

	% store style ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	store-style .bool_set:N = \l_nsk_block_store_style_bool,
	store-style .default:n = {true},
	store-style .initial:n = {false},

	% padding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	padding-x .dim_set:N = \l_nsk_block_padding_x_dim,
	padding-x .initial:V = \g__nsk_style_block_padding_x_dim,
	padding-x .default:V = \g__nsk_style_block_padding_x_dim,

	padding-y .dim_set:N = \l_nsk_block_padding_y_dim,
	padding-y .initial:V = \g__nsk_style_block_padding_y_dim,
	padding-y .default:V = \g__nsk_style_block_padding_y_dim,

	% ref-id ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	id .tl_set:N = \l_nsk_block_id_tl,
	id .initial:n = { },

	% coords ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	% Use code handler to accept both unitless (e.g., x=0) and with-unit (e.g., x=1cm)
	% Unitless values get cm appended (TikZ default)
	x .code:n = { \__nsk_set_coord_dim:Nn \l_nsk_block_x_dim {#1} },
	x .initial:n = {0pt},
	x .default:n = {0pt},

	y .code:n = { \__nsk_set_coord_dim:Nn \l_nsk_block_y_dim {#1} },
	y .initial:n = {0pt},
	y .default:n = {0pt},

	shift-x .tl_set:N = \l_nsk_block_shiftx_tl,
	shift-x .initial:n = {0},
	shift-x .default:n = {0},

	shift-y .tl_set:N = \l_nsk_block_shifty_tl,
	shift-y .initial:n = {0},
	shift-y .default:n = {0},

	anchor .tl_set:N = \l_nsk_block_anchor_tl,
	anchor .initial:V = \g__nsk_style_block_anchor_tl,
	anchor .default:V = \g__nsk_style_block_anchor_tl,

	rotate .tl_set:N = \l_nsk_block_rotate_tl,
	rotate .initial:V = \g__nsk_style_block_rotate_tl,
	rotate .default:V = \g__nsk_style_block_rotate_tl,

	opacity .tl_set:N = \l_nsk_block_opacity_tl,
	opacity .initial:V = \g__nsk_style_block_opacity_tl,
	opacity .default:V = \g__nsk_style_block_opacity_tl,

	% natural positioning using positioning library
	pos .tl_set:N = \l_nsk_block_pos_tl,
	pos .initial:n = { },

  pos^ .code:n = {
    \int_compare:nNnTF {\g_nsk_block_skip_pos_counter_int} = {0}
    {\int_gset:Nn \g_nsk_block_skip_pos_counter_int {1}}
    {
      \tl_set:Nn \l_nsk_block_pos_tl {#1}
    }

  },
	pos^ .initial:n = { },
	pos^ .default:n = { },

	% last-nat pos ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	last-pos .tl_set:N = \l_nsk_block_last_pos_tl,
	last-pos .initial:n = { },
	last-pos .default:n = { },

  last-pos^ .code:n = {
    \int_compare:nNnTF {\g_nsk_block_skip_pos_counter_int} = {0}
    {\int_gset:Nn \g_nsk_block_skip_pos_counter_int {1}}
    {
      \tl_set:Nn \l_nsk_block_last_pos_tl {#1}
    }

  },
	last-pos^ .initial:n = { },
	last-pos^ .default:n = { },

	% (works like last-pos but without error)
	last-pos-s .tl_set:N = \l_nsk_block_last_pos_s_tl,
	last-pos-s .initial:n = { },
	last-pos-s .default:n = { },

  last-pos-s^ .code:n = {
    \int_compare:nNnTF {\g_nsk_block_skip_pos_counter_int} = {0}
    {\int_gset:Nn \g_nsk_block_skip_pos_counter_int {1}}
    {
      \tl_set:Nn \l_nsk_block_last_pos_s_tl {#1}
    }

  },
	last-pos-s^ .initial:n = { },
	last-pos-s^ .default:n = { },

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Alignment (flush.)
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	align .choice:,
	align / top .code:n = { \tl_set:Nn \l_nsk_block_align_tl { top } },
	align / bottom .code:n = { \tl_set:Nn \l_nsk_block_align_tl { bottom } },
	align / center .code:n = { \tl_set:Nn \l_nsk_block_align_tl { center } },
	align / none .code:n = { \tl_set:Nn \l_nsk_block_align_tl { none } },
	align .initial:n = {none},
	align .default:n = {none},


	% dimensions ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	width .dim_set:N =  \l_nsk_block_width_dim,
	width .initial:V = \g__nsk_style_block_width_dim,
	width .default:V = \g__nsk_style_block_width_dim,

	height .dim_set:N = \l_nsk_block_height_dim,
	height .default:V = \g__nsk_style_block_height_dim,
	height .initial:V = \g__nsk_style_block_height_dim,

	size .code:n = {
			\dim_set:Nn \l_nsk_block_width_dim {#1}
			\dim_set:Nn \l_nsk_block_height_dim {#1}
		},


	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Inner (regular) border
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	border-type .code:n =
		{
			\tl_set:Nn \l_nsk_block_border_type_tl {#1}

		},

	border-type .initial:n = {solid},
	border-type .default:n = {solid},

	border-color .tl_set:N = \l_nsk_block_border_color_tl,
	border-color .initial:V = \g__nsk_style_block_border_color_tl,
	border-color .default:V = \g__nsk_style_block_border_color_tl,

	border-radius .code:n = {
			\dim_set:Nn \l_nsk_block_border_radius_dim {#1}
			\bool_set_true:N \l_nsk_block_border_radius_mset_bool
		},
	border-radius .initial:V = \g__nsk_style_block_border_radius_dim,
	border-radius .default:V = \g__nsk_style_block_border_radius_dim,

	border-radius-scale .bool_set:N = \l_nsk_block_border_radius_scale_bool,
	border-radius-scale .initial:n = {true},
	border-radius-scale .default:n = {true},

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Per-corner border radius
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	% Per-corner border radius - NO .initial:n to avoid triggering mset_bool
	% The dimensions are initialized to 0pt by \dim_new:N
	% The mset_bool stays false unless user explicitly sets the key
	border-radius-nw .code:n = {
		\dim_set:Nn \l_nsk_block_border_radius_nw_dim {#1}
		\bool_set_true:N \l_nsk_block_border_radius_nw_mset_bool
	},

	border-radius-ne .code:n = {
		\dim_set:Nn \l_nsk_block_border_radius_ne_dim {#1}
		\bool_set_true:N \l_nsk_block_border_radius_ne_mset_bool
	},

	border-radius-sw .code:n = {
		\dim_set:Nn \l_nsk_block_border_radius_sw_dim {#1}
		\bool_set_true:N \l_nsk_block_border_radius_sw_mset_bool
	},

	border-radius-se .code:n = {
		\dim_set:Nn \l_nsk_block_border_radius_se_dim {#1}
		\bool_set_true:N \l_nsk_block_border_radius_se_mset_bool
	},

	border-size .dim_set:N = \l_nsk_block_border_size_dim,
	border-size .initial:V = \g__nsk_style_block_border_size_dim,
	border-size .default:V = \g__nsk_style_block_border_size_dim,

	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Outer (halo) border
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<

	outer-border-type .code:n =
		{
			\tl_if_eq:nnTF {#1}{none}
			{
				\tl_set:Nn \l_nsk_block_outer_border_type_tl {draw=none}
			}
			{
				\tl_set:Nn \l_nsk_block_outer_border_type_tl {#1}
			}

		},

	outer-border-type .initial:V = \g__nsk_style_block_outer_border_type_tl,
	outer-border-type .default:V = \g__nsk_style_block_outer_border_type_tl,

	outer-border-color .tl_set:N = \l_nsk_block_outer_border_color_tl,
	outer-border-color .initial:V = \g__nsk_style_block_outer_border_color_tl,
	outer-border-color .default:V = \g__nsk_style_block_outer_border_color_tl,

	outer-border-radius .dim_set:N = \l_nsk_block_outer_border_radius_dim,
	outer-border-radius .initial:V = \g__nsk_style_block_outer_border_radius_dim,
	outer-border-radius .default:V = \g__nsk_style_block_outer_border_radius_dim,

	outer-border-size .dim_set:N = \l_nsk_block_outer_border_size_dim,
	outer-border-size .initial:V = \g__nsk_style_block_outer_border_size_dim,
	outer-border-size .default:V = \g__nsk_style_block_outer_border_size_dim,

	% styles ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	fill .tl_set:N = \l_nsk_block_fill_tl,
	fill .initial:V = \g__nsk_style_block_fill_tl,
	fill .default:V = \g__nsk_style_block_fill_tl,

	% shadow ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	shadow .bool_set:N = \l_nsk_block_shadow_bool,
	shadow .initial:n = {true},
	shadow .default:n = {true},

	% importance ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	importance .fp_set:N = \l_nsk_block_importance_fp,
	importance .initial:V = \g__nsk_style_block_importance_fp,
	importance .default:V = \g__nsk_style_block_importance_fp,

	% -- The special pass-through key for arbitrary TikZ options.
	tikz-opts  .code:n =
		{
