% ------------------------------------------------------------------------------
% Helper: Resolve TikZ positioning (pos_tl) to x/y coordinates
% When last-pos or similar is used, we need to get actual coordinates
% ------------------------------------------------------------------------------
\cs_new_protected:Npn \__nsk_persp_resolve_position:
{
	\tl_if_blank:VF \l_nsk_block_pos_tl
	{
		% Create a temporary invisible node to get the coordinates
		% Build positioning options including anchor if specified
		\tl_clear:N \l_tmpa_tl
		\tl_put_right:NV \l_tmpa_tl \l_nsk_block_pos_tl
		\tl_if_blank:VF \l_nsk_block_anchor_tl
		{
			\tl_put_right:Nn \l_tmpa_tl { , anchor= }
			\tl_put_right:NV \l_tmpa_tl \l_nsk_block_anchor_tl
		}

		% Create temporary node and extract center coordinates
		\use:x {
			\exp_not:N \node [
				\l_tmpa_tl,
				minimum~width=\dim_use:N \l_nsk_block_width_dim,
				minimum~height=\dim_use:N \l_nsk_block_height_dim,
				inner~sep=0pt,
			] (nsk@temp@pos) {};
		}

		% Extract center coordinates from the temporary node
		\path (nsk@temp@pos.center);
		\pgfgetlastxy{\l_tmpa_tl}{\l_tmpb_tl}
		\dim_set:Nn \l_nsk_block_x_dim { \l_tmpa_tl }
		\dim_set:Nn \l_nsk_block_y_dim { \l_tmpb_tl }
	}
}

% ------------------------------------------------------------------------------
% Main dispatcher: routes to appropriate shape renderer
% ------------------------------------------------------------------------------
\cs_new_protected:Npn \__nsk_block_render_perspective:
{
	% First resolve any TikZ positioning to x/y coordinates
	\__nsk_persp_resolve_position:

	% Dispatch based on shape type
	\str_case:VnF \l_nsk_block_type_tl
	{
		{ rectangle }        { \__nsk_persp_render_rectangle: }
		{ circle }           { \__nsk_persp_render_ellipse: }
		{ ellipse }          { \__nsk_persp_render_ellipse: }
		{ diamond }          { \__nsk_persp_render_diamond: }
		{ regular~polygon }  { \__nsk_persp_render_polygon: }
		{ star }             { \__nsk_persp_render_star: }
		{ text }             { \__nsk_persp_render_text: }
		{ icon }             { \__nsk_persp_render_text: }
	}
	{
		% Default: treat as rectangle (trapezoid)
		\__nsk_persp_render_rectangle:
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Block drawing [Aux]
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__draw_block_aux:n #1
{

% Check for perspective mode dispatch
\bool_if:NTF \g__nsk_threed_perspective_active_bool
{
	% Perspective mode: custom trapezoid path
	\__nsk_block_render_perspective:
}
{
	% Normal mode: existing TikZ node
	\tl_if_blank:VTF \l_nsk_block_grid_args_tl
	{
		\node [
			spath/save~global=\l_nsk_block_id_tl,
			#1,
		] {};
	}
{
% update width to account for border size
\dim_set:Nn \l_nsk_block_width_dim {\l_nsk_block_width_dim - \l_nsk_block_border_size_dim}
\dim_set:Nn \l_nsk_block_height_dim {\l_nsk_block_height_dim - \l_nsk_block_border_size_dim}

% Compute spacing from segment count if specified
\int_compare:nNnT { \l_nsk_block_grid_segx_int } > { 0 }
{
	\dim_set:Nn \l_nsk_block_grid_stepx_dim { \l_nsk_block_width_dim / \l_nsk_block_grid_segx_int }
}
\int_compare:nNnT { \l_nsk_block_grid_segy_int } > { 0 }
{
	\dim_set:Nn \l_nsk_block_grid_stepy_dim { \l_nsk_block_height_dim / \l_nsk_block_grid_segy_int }
}

% Calculate number of horizontal and vertical lines
\int_set:Nn \l_tmpa_int {  \l_nsk_block_width_dim / \l_nsk_block_grid_stepx_dim -2 }
\int_set:Nn \l_tmpb_int {  \l_nsk_block_height_dim / \l_nsk_block_grid_stepy_dim  -2 }

\node [
spath/save~global=\l_nsk_block_id_tl, #1,
path~picture={
% horizontal
\int_step_inline:nnnn {0}{1}{\l_tmpb_int}
{
	\draw[draw=\l_nsk_block_border_color_tl, draw~opacity=\l_nsk_block_opacity_tl, line~width=\l_nsk_block_grid_sizex_dim]
	(-\l_nsk_block_width_dim/2, ########1 * \l_nsk_block_grid_stepy_dim-\l_nsk_block_height_dim/2 + \l_nsk_block_grid_stepy_dim)
	-- (\l_nsk_block_width_dim, ########1 * \l_nsk_block_grid_stepy_dim-\l_nsk_block_height_dim/2 + \l_nsk_block_grid_stepy_dim);
}

% vertical
\int_step_inline:nnnn {0}{1}{\l_tmpa_int}
{
	\draw[draw=\l_nsk_block_border_color_tl, draw~opacity=\l_nsk_block_opacity_tl, line~width=\l_nsk_block_grid_sizey_dim]
	(########1 * \l_nsk_block_grid_stepx_dim-\l_nsk_block_width_dim/2 + \l_nsk_block_grid_stepx_dim, -\l_nsk_block_height_dim/2)
	-- (########1 * \l_nsk_block_grid_stepx_dim-\l_nsk_block_width_dim/2 + \l_nsk_block_grid_stepx_dim, \l_nsk_block_height_dim);
}
}
] {};
}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Grid Cell References - creates <id>-<row>-<col> coordinates at cell centers
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\bool_if:NT \l_nsk_block_grid_refs_bool
{
	\tl_if_blank:VF \l_nsk_block_grid_args_tl
	{
		% Calculate complete cell count using same approach as grid drawing
		% Note: width/height have been reduced by border_size in grid drawing code
		\int_set:Nn \l_nsk_grid_cols_int { \l_nsk_block_width_dim / \l_nsk_block_grid_stepx_dim }
		\int_set:Nn \l_nsk_grid_rows_int { \l_nsk_block_height_dim / \l_nsk_block_grid_stepy_dim }

		% Expose cell dimensions to users as \nskCellWidth and \nskCellHeight
		\dim_gset:Nn \g_nsk_cell_width_dim { \l_nsk_block_grid_stepx_dim }
		\dim_gset:Nn \g_nsk_cell_height_dim { \l_nsk_block_grid_stepy_dim }

		% Pre-compute max indices (cols-1 and rows-1) for loop bounds
		\int_set:Nn \l_nsk_grid_max_col_int { \l_nsk_grid_cols_int - 1 }
		\int_set:Nn \l_nsk_grid_max_row_int { \l_nsk_grid_rows_int - 1 }

		% Iterate rows (0 = top)
		\int_step_inline:nnnn {0}{1}{ \int_use:N \l_nsk_grid_max_row_int }
		{
			% Iterate columns (0 = left)
			\int_step_inline:nnnn {0}{1}{ \int_use:N \l_nsk_grid_max_col_int }
			{
				% X: -width/2 + stepx/2 + col*stepx - border_offset
				% (subtract border_size/2 to compensate for reduced dimensions shifting right)
				\dim_set:Nn \l_tmpa_dim { -\l_nsk_block_width_dim/2 + \l_nsk_block_grid_stepx_dim/2 - \l_nsk_block_border_size_dim/2 }
				\dim_add:Nn \l_tmpa_dim { ####1\l_nsk_block_grid_stepx_dim }
				% Y: +height/2 - stepy/2 - row*stepy + border_offset
				% (add border_size/2 to compensate for reduced dimensions shifting down)
				\dim_set:Nn \l_tmpb_dim { \l_nsk_block_height_dim/2 - \l_nsk_block_grid_stepy_dim/2 + \l_nsk_block_border_size_dim/2 }
				\dim_sub:Nn \l_tmpb_dim { ##1\l_nsk_block_grid_stepy_dim }

				% Create coordinate: <id>-<row>-<col>
				\coordinate (\l_nsk_block_id_tl-##1-####1)
					at ($(\l_nsk_block_id_tl.center) + (\l_tmpa_dim, \l_tmpb_dim)$);
			}
		}
	}
}

% embedding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_if_blank:VF {\l_nsk_embed_tl}
{
	\dim_set:Nn \l_tmpa_dim { \l_nsk_block_width_dim - 2\l_nsk_block_embed_padding_dim }
	\dim_set:Nn \l_tmpb_dim { \l_nsk_block_height_dim - 2\l_nsk_block_embed_padding_dim }

	\begin{scope}
		\pgftransformshift{\pgfpointanchor{\tl_use:N \l_nsk_block_id_tl}{center}}
		\pgfset{minimum\space width=\l_tmpa_dim, minimum\space height=\l_tmpb_dim}
		\pgfsetcornersarced{\pgfpoint{\l_nsk_block_embed_border_radius_dim}{\l_nsk_block_embed_border_radius_dim}}%
		\dim_compare:nNnTF {\l_nsk_block_embed_border_size_dim} = {0pt}
		{
		% Ember border size is 0, so do not draw a border.
		\pgfnode{\l_nsk_block_type_tl}{center}{}{nodename}{\pgfusepath{clip}}
		}
		{
		% Ember border size is nonzero; set the linewidth and draw border.
		\pgfsetlinewidth{\l_nsk_block_embed_border_size_dim}
		\pgfsetstrokecolor{\l_nsk_block_embed_border_color_tl}
		\pgfnode{\l_nsk_block_type_tl}{center}{}{nodename}{\pgfusepath{stroke,clip}}
		}
		% raw embedding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
		\tl_use:N \l_nsk_embed_tl
	\end{scope}

}

\tl_if_blank:VF {\l_nsk_embed_gfx_tl}
{
	\dim_set:Nn \l_tmpa_dim { \l_nsk_block_width_dim - 2\l_nsk_block_embed_padding_dim }
	\dim_set:Nn \l_tmpb_dim { \l_nsk_block_height_dim - 2\l_nsk_block_embed_padding_dim }

	\begin{scope}
		\pgftransformshift{\pgfpointanchor{\tl_use:N \l_nsk_block_id_tl}{center}}
		\pgfset{minimum~width=\l_tmpa_dim, minimum~height=\l_tmpb_dim}
		\pgfsetcornersarced{\pgfpoint{\l_nsk_block_embed_border_radius_dim}{\l_nsk_block_embed_border_radius_dim}}%

		\dim_compare:nNnTF {\l_nsk_block_embed_border_size_dim} = {0pt}
		{
    % TODO: rework this, quick workaround rn
    \tl_if_eq:NnT \l_nsk_block_type_tl {superellipse}
    {
      \pgfkeys{/pgf/superellipse~x~exponent=\l_nsk_block_squircle_ex_tl}
      \pgfkeys{/pgf/superellipse~y~exponent=\l_nsk_block_squircle_ex_tl}
      \pgfkeys{/pgf/superellipse~step=\l_nsk_block_squircle_step_tl}
    }

		% Ember border size is 0, so do not draw a border.
		\pgfnode{\l_nsk_block_type_tl}{center}{}{nodename}{\pgfusepath{clip}}
		}
		{
		% Ember border size is nonzero; set the linewidth and draw border.
		\pgfsetlinewidth{\l_nsk_block_embed_border_size_dim}
		\pgfsetstrokecolor{\l_nsk_block_embed_border_color_tl}
    % TODO: rework this, quick workaround rn
    \tl_if_eq:NnT \l_nsk_block_type_tl {superellipse}
    {
      \pgfkeys{/pgf/superellipse~x~exponent=\l_nsk_block_squircle_ex_tl}
      \pgfkeys{/pgf/superellipse~y~exponent=\l_nsk_block_squircle_ex_tl}
      \pgfkeys{/pgf/superellipse~step=\l_nsk_block_squircle_step_tl}
    }
		\pgfnode{\l_nsk_block_type_tl}{center}{}{nodename}{\pgfusepath{stroke,clip}}
		}

		% gfx node ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
		\node[]
		{\includegraphics[width=\l_tmpa_dim+1.2pt, height=\l_tmpb_dim+1.2pt]{\tl_use:N \l_nsk_embed_gfx_tl}};
	\end{scope}

}


}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Pattern Aliasing resolution
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__resolve_pattern_alias:
{
	% If \l_nsk_block_pattern_tl is empty, do nothing
	\tl_if_blank:VTF \l_nsk_block_pattern_tl
	{ }
	{
		% Check if the user's pattern key is in the alias property
		\prop_if_in:NVTF \g_nsk_pattern_aliases_prop \l_nsk_block_pattern_tl
		{
			% It's an alias => retrieve the real pattern
			\prop_get:NVN \g_nsk_pattern_aliases_prop \l_nsk_block_pattern_tl \l_tmpa_tl
			\tl_set:NV \l_nsk_block_pattern_tl \l_tmpa_tl
		}
		{
			% Not an alias => user gave a real pattern or a custom name => do nothing
		}
	}
}


\cs_new_protected_nopar:Npn \nsk__build_block_style:
{
% Build the style token list incrementally:
\tl_clear_new:N \l_tmps_tl

\tl_set:Nn \l_tmp_pre_acts {}
\tl_set:Nn \l_tmp_post_acts {}

% extras ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\nsk__resolve_pattern_alias:

% If fade is not "none", then override some keys and add a fade style.
\tl_if_eq:NnF \l_nsk_block_fade_tl { none }
{
	% Disable shadow
	\bool_set_false:N \l_nsk_block_shadow_bool
	\tl_put_right:Nx \l_tmps_tl {fade~\l_nsk_block_fade_tl ,}

	\bool_if:NTF \g__nsk_dark_mode_bool
	{}
	{
		\str_case:Vn \l_nsk_block_fade_tl
		{
			{down} {\tl_put_right:Nn \l_tmps_tl {top~color=transparent!0, bottom~color=nskBg,}}
				{up} {\tl_put_right:Nn \l_tmps_tl {bottom~color=transparent!0, top~color=nskBg,}}
				{left} {\tl_put_right:Nn \l_tmps_tl {right~color=transparent!0, left~color=nskBg,}}
				{right} {\tl_put_right:Nn \l_tmps_tl {left~color=transparent!0, right~color=nskBg,}}
		}
	}
}

% Possibly scale border-size according to importance:
\nsk__maybe_scale_border_by_importance:
\nsk__maybe_uniform_border_scaling:

% id-ref ---------------------------------------------------
\tl_put_right:No \l_tmps_tl { name=\l_nsk_block_id_tl,}

% wrapping --
\bool_if:NTF \g_nsk_wrap_left_bool
{
	\tl_set:Nn \l_nsk_block_anchor_tl {\l__nsk_wrap_anchor_tl\space west}
	\tl_set:Nn \l_nsk_block_pos_tl {\l__nsk_wrap_direction_tl\space left=0mm~and~-.5mm~of~\nskID{1}}

	\bool_gset_false:N \g_nsk_wrap_left_bool
}{
	\bool_if:NTF \g_nsk_wrap_right_bool
	{
		\tl_set:Nn \l_nsk_block_anchor_tl {\l__nsk_wrap_anchor_tl\space east}
		\tl_set:Nn \l_nsk_block_pos_tl {\l__nsk_wrap_direction_tl~right=0mm~and~.5mm~of~\nskID{1}}

		\bool_gset_false:N \g_nsk_wrap_right_bool
	}{}
}

% {x,y} pos ------------------------------------------------
\tl_if_blank:VTF \l_nsk_block_pos_tl
{
	% -- pos is blank => place the node using x,y
	\tl_put_right:Nx \l_tmps_tl
	{ at={(\dim_use:N \l_nsk_block_x_dim,\dim_use:N \l_nsk_block_y_dim)}, }
}
{
	% -- pos is given => place the node by raw TikZ positioning
	% i.e., [right=2cm of otherNode]
	\tl_put_right:No \l_tmps_tl { \l_nsk_block_pos_tl, }
}
% rotate ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_put_right:Nx \l_tmps_tl
{ rotate=\l_nsk_block_rotate_tl, }
% opacity ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_put_right:Nx \l_tmps_tl
{ opacity=\l_nsk_block_opacity_tl, }

% additional shift ~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_put_right:No \l_tmps_tl { xshift=\l_nsk_block_shiftx_tl,}
\tl_put_right:No \l_tmps_tl { yshift=\l_nsk_block_shifty_tl,}


\tl_if_blank:VF \l_nsk_block_anchor_tl
{
	\tl_put_right:No \l_tmps_tl {anchor=\l_nsk_block_anchor_tl,}
}

% shape-type ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_if_eq:NnF \l_nsk_block_type_tl {text}{
	\tl_if_eq:NnF \l_nsk_block_type_tl {icon}
	{\tl_put_right:No \l_tmps_tl {shape=\l_nsk_block_type_tl,}}
}
% dims ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_put_right:No \l_tmps_tl {minimum\space width=\l_nsk_block_width_dim,}
\tl_put_right:No \l_tmps_tl {minimum\space height=\l_nsk_block_height_dim,}
% borders ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<

% outer-border
\tl_if_blank:VF \l_nsk_block_grid_args_tl
{
	\bool_if:NF \l_nsk_block_grid_outerb_tl
	{\tl_put_right:No \l_tmps_tl {draw~opacity=0,}}
}

% Determine if per-corner mode is needed
\nsk__determine_percorner_mode:

% Handle border drawing based on per-corner mode
\bool_if:NTF \l_nsk_block_percorner_mode_bool
{
	% Per-corner mode: make node invisible, we'll draw the shape overlay
	\tl_put_right:No \l_tmps_tl {draw=none, fill=none,}
	\tl_put_right:No \l_tmps_tl {rounded\space corners=0,}
}
{
	% Standard mode: use existing border logic
	% type=text gets no border automatically
	\tl_if_eq:NnTF \l_nsk_block_type_tl {text}
	{
		\tl_put_right:Nn \l_tmps_tl {draw=none,}
	}
	{
		\tl_if_eq:NnTF \l_nsk_block_border_type_tl { none }
		{
			\tl_put_right:Nn \l_tmps_tl {draw=none,}
		}
		{
			\tl_if_eq:NnT \l_nsk_block_fade_tl { none }
			{\tl_put_right:No \l_tmps_tl {draw=\l_nsk_block_border_color_tl,}}
			\tl_put_right:No \l_tmps_tl {\l_nsk_block_border_type_tl,}
		}

		\tl_if_in:nVTF {cylinder~cloud~signal~tape} \l_nsk_block_type_tl
		{\tl_put_right:No \l_tmps_tl {rounded\space corners=0,}}
		{
			\tl_if_eq:NnTF \l_nsk_block_type_tl {rounded~rectangle}
			{\tl_put_right:No \l_tmps_tl {rounded\space corners=0,}}
			{\tl_put_right:No \l_tmps_tl {rounded\space corners=\l_nsk_block_border_radius_dim,}}
		}
	}
}


\tl_put_right:No \l_tmps_tl {line\space width=\l_nsk_block_border_size_dim,}
% outer border ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_put_right:No \l_tmp_pre_acts {draw=\l_nsk_block_outer_border_color_tl,}
\tl_put_right:No \l_tmp_pre_acts {\l_nsk_block_outer_border_type_tl,}
\tl_put_right:No \l_tmp_pre_acts {rounded\space corners=\l_nsk_block_outer_border_radius_dim,}
\tl_put_right:No \l_tmp_pre_acts {line\space width=\l_nsk_block_outer_border_size_dim,}

% fill ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
% Skip fill for node when in per-corner mode (custom draw handles it)
% type=text gets no fill automatically
\bool_if:NF \l_nsk_block_percorner_mode_bool
{
	\tl_if_eq:NnTF \l_nsk_block_type_tl {text}
	{\tl_put_right:Nn \l_tmps_tl {fill=none,}}
	{
		\tl_if_eq:NnTF \l_nsk_block_fade_tl { none }
		{\tl_put_right:No \l_tmps_tl {fill=\l_nsk_block_fill_tl,}}
		{\tl_put_right:No \l_tmps_tl {fill=nskBg,}}
	}
}


% stacks ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
