% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Check if type is polygon[n] and process accordingly
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__check_polygon_type:
{
	% Create temporary seq variable for regex extraction
	\seq_clear_new:N \l_tmpa_seq

	% Check if type matches polygon[n] pattern
	\regex_match:nVTF {polygon\[[0-9]+\]} \l_nsk_block_type_tl
	{
		% Extract the number of sides using regex
		\regex_extract_once:nVN {polygon\[([0-9]+)\]} \l_nsk_block_type_tl \l_tmpa_seq
		\tl_set:Nx \l_poly_n_tl {\seq_item:Nn \l_tmpa_seq {2}}

		% Set the type to "regular polygon"
		\tl_set:Nn \l_nsk_block_type_tl {regular~polygon}
		\tl_show:N \l_poly_n_tl

		% Append "regular polygon sides=n" to tikz-opts
		\tl_if_empty:VTF \l_nsk_block_extra_style_tl
		{
			\tl_set:Nx \l_nsk_block_extra_style_tl {regular~polygon~sides=\l_poly_n_tl}
		}
		{
			\tl_put_right:Nx \l_nsk_block_extra_style_tl {, regular~polygon~sides=\l_poly_n_tl}
		}
	}
	{ }
}

