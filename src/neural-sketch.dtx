% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Position jumps (skips)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\NewDocumentCommand {\nskReset} {o} {
  \str_case:nnF {#1}
  {
    {pos} {\int_gset:Nn \g_nsk_block_skip_pos_counter_int {1}}
  }{
    % reset all - counter=1 means normal last-pos works
    % (counter=0 is only set by containers/groups with scope-first-pos)
    \int_gset:Nn \g_nsk_block_skip_pos_counter_int {1}
  }
}

