% Diagram Fadings / Shadings
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<

\keys_define:nn { nsk / efadings }
{
	edge .tl_set:N = \l_nsk_efadings_type_tl,
	edge .initial:n   = {down},
	edge .default:n   = {down},

	size .dim_set:N = \l_nsk_efadings_size_dim,
	size .initial:n   = {10mm},
	size .default:n   = {10mm},

	offset .dim_set:N = \l_nsk_efadings_offset_dim,
	offset .initial:n   = {1mm},
	offset .default:n   = {1mm},

}

\NewDocumentCommand {\nskEdgeFade} { O{} }{

	% parse
	\keys_set:nn { nsk / efadings } { #1 }

	% match pos
	\tl_clear_new:N \l_tmpefpos_tl
	\str_case:Vn \l_nsk_efadings_type_tl
	{
		{down}{\tl_set:Nx \l_tmpefpos_tl {above~right=-\dim_use:N \l_nsk_efadings_offset_dim\space of~current~bounding~box.south~west}}
			{up}{\tl_set:Nx \l_tmpefpos_tl {below~right=-\dim_use:N \l_nsk_efadings_offset_dim\space of~current~bounding~box.north~west}}
			{left}{\tl_set:Nx \l_tmpefpos_tl {above~right=-\dim_use:N \l_nsk_efadings_offset_dim\space of~current~bounding~box.south~west}}
			{right}{\tl_set:Nx \l_tmpefpos_tl {above~left=-\dim_use:N \l_nsk_efadings_offset_dim\space of~current~bounding~box.south~east}}
	}


	% sizings
	\tl_clear_new:N \l_tmpw_tl
	\tl_clear_new:N \l_tmph_tl
	\str_case:Vn \l_nsk_efadings_type_tl
	{
		{down}{
				% measure
				\nskMeasure[from=current~bounding~box.south~west, to=current~bounding~box.south~east]
				\tl_set:Nx \l_tmpw_tl {\nskDistance + \l_nsk_efadings_offset_dim}
				\tl_set:Nx \l_tmph_tl {\l_nsk_efadings_size_dim}
			}
			{up}{
				% measure
				\nskMeasure[from=current~bounding~box.south~west, to=current~bounding~box.south~east]
				\tl_set:Nx \l_tmpw_tl {\nskDistance + \l_nsk_efadings_offset_dim}
				\tl_set:Nx \l_tmph_tl {\l_nsk_efadings_size_dim}
			}
			{left}{
				% measure
				\nskMeasure[
					from=current~bounding~box.south~west, to=current~bounding~box.north~west,
					axis=vertical
				]
				\tl_set:Nx \l_tmph_tl {\nskDistance + \l_nsk_efadings_offset_dim}
				\tl_set:Nx \l_tmpw_tl {\l_nsk_efadings_size_dim}
			}
			{right}{
				% measure
				\nskMeasure[
					from=current~bounding~box.south~east, to=current~bounding~box.north~east,
					axis=vertical
				]
				\tl_set:Nx \l_tmph_tl {\nskDistance + \l_nsk_efadings_offset_dim}
				\tl_set:Nx \l_tmpw_tl {\l_nsk_efadings_size_dim}
			}

	}

	\nsk__render_edge_fading:VVVV
	\l_tmpefpos_tl
	\l_tmpw_tl
	\l_tmph_tl
	\l_nsk_efadings_type_tl

}
