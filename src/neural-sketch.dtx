% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Ref-Counter history
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__store_block_in_history:
{
	% Push the current block's ID into the global sequence
	\seq_gput_right:Nx \g_nsk_block_id_history_seq \l_nsk_block_id_tl
}

\cs_new_protected_nopar:Npn \nsk__internal_get_nth_block_id:n #1
{
	% #1 => integer offset n (nth-last)
	% We will reference the global \g_nsk_block_id_history_seq inside.


	\seq_if_empty:NTF \g_nsk_block_id_history_seq
	{
		\tl_set:Nn \l_tmpa_tl {ERROR-NoBlocks}
		\GenericError{}{No block in the history!}{}{%
			Attempted~to~reference~\string\nskBlockIDLast[#1],~but~no~blocks~exist.%
		}
	}
	{
		\int_compare:nNnTF {#1} > { \seq_count:N \g_nsk_block_id_history_seq }
			{
				\tl_set:Nn \l_tmpa_tl {ERROR-BadIndex}
				\GenericError{}{Block~index~out~of~bounds~}{}{%
					\string\nskBlockIDLast[#1] exceeds the number of existing blocks.%
				}
			}
			{
				% We want the item at "(total - n + 1)."
				\tl_set:No \l_tmpa_tl
				{
					\seq_item:Nn
					\g_nsk_block_id_history_seq
					{ \int_eval:n{ \seq_count:N \g_nsk_block_id_history_seq - #1 + 1} }
				}
			}
	}


	% Return it by expanding the token list \l_tmpa_tl
	% \tl_use:N \l_tmpa_tl
	\tl_gset:Nx \g_nsk_block_last_requested_block_id {\l_tmpa_tl}

	% \seq_show:N \g_nsk_block_id_history_seq
	% \tl_show:N \g_nsk_block_last_requested_block_id
}


% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Text measurement and block resizing
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__maybe_resize_block_to_text:
{
	% If text-center is not empty, calculate natural dimensions
	\tl_if_blank:VF \l_nsk_text_center_tl
	{
		% Create a phantom node to measure text dimensions
		\node[
			inner~sep=0pt,outer~sep=0,draw=none,fill=none,text~opacity=0, opacity=0
		] (temp) {\l_nsk_text_center_tl};

		% Get natural dimensions
		\pgfextractx{\l_tmpa_dim}{\pgfpointdiff{\pgfpointanchor{temp}{west}}{\pgfpointanchor{temp}{east}}}
		\pgfextracty{\l_tmpb_dim}{\pgfpointdiff{\pgfpointanchor{temp}{south}}{\pgfpointanchor{temp}{north}}}
		% Set block dimensions to text size plus padding
		\dim_set:Nn \l_nsk_block_width_dim {\l_tmpa_dim + 2\l_nsk_block_padding_x_dim}
		\dim_set:Nn \l_nsk_block_height_dim {\l_tmpb_dim + 2\l_nsk_block_padding_y_dim}
	}
}


% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Alignent (flush)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__process_align:
{

	% parse the horizontal and vertical direction
	\seq_set_split:Nnx \l_tmpa_seq {=}{\l_nsk_block_pos_tl}

	% h-dir
	\tl_clear_new:N \l_tmp_hdirc_tl
	\tl_clear_new:N \l_tmp_hdira_tl

	% If there's at least two items, we can inspect the first part
	%    (the directions) to pick a multi-word anchor.
	\int_compare:nNnT { \seq_count:N \l_tmpa_seq } > {1}
		{
			% \l_tmpa_tl := "below right" (for example)
			\tl_set:Nx \l_tmpa_lx_tl { \seq_item:Nn \l_tmpa_seq {1} }
			% 0cm and 0cm of basics.<..>
			\tl_set:Nx \l_tmpa_rx_tl { \seq_item:Nn \l_tmpa_seq {2} }

			\tl_if_in:nVT {right} \l_tmpa_lx_tl
			{
				\tl_set:Nn \l_tmp_hdirc_tl {east}
				\tl_set:Nn \l_tmp_hdira_tl {west}
			}
			\tl_if_in:nVT {left} \l_tmpa_lx_tl
			{
				\tl_set:Nn \l_tmp_hdirc_tl {west}
				\tl_set:Nn \l_tmp_hdira_tl {east}
			}
		}

	\str_case:Vn \l_nsk_block_align_tl
	{
		{top}
			{
				\tl_put_right:No \l_nsk_block_pos_tl {.north~\l_tmp_hdirc_tl}
				\tl_set:No \l_nsk_block_anchor_tl {north~\l_tmp_hdira_tl}
			}
			{bottom}
			{
				\tl_put_right:No \l_nsk_block_pos_tl {.south~\l_tmp_hdirc_tl}
				\tl_set:No \l_nsk_block_anchor_tl {south~\l_tmp_hdira_tl}
			}
			{center}
			{
				\tl_put_right:No \l_nsk_block_pos_tl {.\l_tmp_hdirc_tl}
				\tl_set:No \l_nsk_block_anchor_tl {\l_tmp_hdira_tl}
			}
			{none}{}
	}
}


% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Main block draw
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\cs_new_protected_nopar:Npn \nsk__draw_block:
{
	\dim_compare:nNnT {\l_nsk_block_width_dim} = {0pt}
		{
			\nsk__maybe_resize_block_to_text:
		}

	% 1. draw the main block shape
	\nsk__build_block_style:

	% 2. draw the text anchorings
	\nsk__render_all_text:
}

