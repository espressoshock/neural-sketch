% external ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\RequirePackage{tikz}
\RequirePackage{expl3}
\usetikzlibrary{
	calc, fit,
	shapes.geometric,
	shapes.symbols,
	shapes.misc,
	arrows.meta,
	positioning,
	arrows.meta,
	shadows,
	shadings,
	patterns,
	backgrounds,
	tikzmark,
	math,
}


\ExplSyntaxOn

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Pkg opts
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prop_new:N \l__nsk_pkgopts_opts_prop
\keys_define:nn { nsk / pkgopts }
{
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	% Dark mode
	% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	dark-mode .bool_gset:N = \g__nsk_dark_mode_bool,
	dark-mode .initial:n   = {false},
	dark-mode .default:n   = {false},

	unknown .code:n =
		{
			\prop_put:Nxx \l__nsk_pkgopts_opts_prop
			{ \tl_use:N \l_keys_key_tl }
			{ #1 }
		},

}
\ProcessKeysOptions { nsk / pkgopts }


% prop->tl
\tl_new:N \l__nsk_pkgopts_opts_tl
\tl_clear:N \l__nsk_pkgopts_opts_tl

\prop_map_inline:Nn \l__nsk_pkgopts_opts_prop
{
	\tl_put_right:Nx \l__nsk_pkgopts_opts_tl
	{
		#1 = {#2},
	}
}


% dark-mode ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\bool_if:NTF \g__nsk_dark_mode_bool
{
\definecolor{ c__nsk_dark_bg_clr }      {HTML}{1d2021}
\definecolor{ c__nsk_principal } {HTML}{ebdbb2}
\pagecolor{c__nsk_dark_bg_clr}
\colorlet{nskBg}{c__nsk_dark_bg_clr}
\colorlet{nskFg}{c__nsk_principal}
\colorlet{nskDarker}{c__nsk_dark_bg_clr}
\colorlet{nskLighter}{c__nsk_principal}
\tikzset{
every~node/.append~style={text=c__nsk_principal},
% every~path/.append~style={draw=red}
}
}
{
\definecolor{ c__nsk_principal } {HTML}{000000}
\colorlet{nskBg}{white}
\colorlet{nskFg}{black}
\colorlet{nskDarker}{nskFg}
\colorlet{nskLighter}{nskBg}
}

\ExplSyntaxOff

% internal ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\RequirePackage{neural-sketch-colors}
\RequirePackage{neural-sketch-styles}
\RequirePackage{neural-sketch-loader}

\ExplSyntaxOn

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Pass-through nsk / style
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\keys_set:nx { nsk / style } { \l__nsk_pkgopts_opts_tl }

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global Stored Styles
% to reuse-previouse elements styles
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prop_new:N \g_nsk_block_stored_style_prop

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global props -
% to track auto-increment counters
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prop_new:N \g_nsk_block_counters_prop
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global seq -
% to track block-id reference counters
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\seq_new:N \g_nsk_block_id_history_seq
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Global flag -
% to track wrapping
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\bool_new:N \g_nsk_wrap_right_bool
\bool_new:N \g_nsk_wrap_left_bool

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Grid dims
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\dim_new:N \l_nsk_block_grid_stepx_dim
\dim_new:N \l_nsk_block_grid_stepy_dim

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Main nsk / Block Primitive
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\keys_define:nn {nsk / block}
{
	% block type ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	type .code:n =
		{
			\bool_lazy_or:nnTF
			{ \str_if_eq_p:nn {#1}{text} }
			{ \str_if_eq_p:nn {#1}{icon} }
			{
				\tl_set:Nn \l_nsk_block_type_tl {rectangle}
				\tl_set:Nn \l_nsk_block_border_type_tl {draw=none}
				\bool_set_false:N \l_nsk_block_shadow_bool
				\tl_set:Nn \l_nsk_block_fill_tl {none}
				% auto width
				\dim_set:Nn \l_nsk_block_width_dim {0cm}
				\dim_set:Nn \l_nsk_block_padding_x_dim {0mm}
			}
			{
				\tl_set:Nn \l_nsk_block_type_tl {#1}
			} % false branch (do nothing)
		},
	type .initial:n = {rectangle},
	type .default:n = {rectangle},

	% grid ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	grid .code:n = {
			\tl_set:Nn \l_nsk_block_grid_args_tl {#1}
			\tl_if_blank:VF \l_nsk_block_grid_args_tl {
				\seq_set_split:Nnn \l_args_seq {,} {#1}

				% set args -> [stepx], [stepy]
				\seq_pop_left:NNT \l_args_seq \l_tmpa_tl { \dim_set:Nn \l_nsk_block_grid_stepx_dim {\l_tmpa_tl} }
				\seq_pop_left:NNT \l_args_seq \l_tmpa_tl { \dim_set:Nn \l_nsk_block_grid_stepy_dim {\l_tmpa_tl} }

				% set some styles
				\bool_set_false:N \l_nsk_block_shadow_bool
				\tl_set:Nn \l_nsk_block_fill_tl {none}
			}
		},
	grid .default:n = {},
	grid .initial:n = {},

	grid-on .tl_set:N = \l_nsk_block_grid_on_tl,
	grid-on .default:n = {},
	grid-on .initial:n = {},

	grid-line-size-x .dim_set:N = \l_nsk_block_grid_sizex_dim,
	grid-line-size-x .default:n = {.4mm},
	grid-line-size-x .initial:n = {.4mm},

	grid-line-size-y .dim_set:N = \l_nsk_block_grid_sizey_dim,
	grid-line-size-y .default:n = {.4mm},
	grid-line-size-y .initial:n = {.4mm},

	grid-line-size .code:n = {
			% \tl_set:Nn \l_nsk_block_grid_size_args_tl {#1}
      \seq_set_split:Nnn \l_args_seq {,} {#1}

				% set args -> [sizex], [sizey]
				\seq_pop_left:NNT \l_args_seq \l_tmpa_tl { \dim_set:Nn \l_nsk_block_grid_sizex_dim {\l_tmpa_tl} }
        \seq_pop_left:NNTF \l_args_seq \l_tmpa_tl
        {\dim_set:Nn \l_nsk_block_grid_sizey_dim {\l_tmpa_tl}}
        {\dim_set_eq:NN \l_nsk_block_grid_sizey_dim \l_nsk_block_grid_sizex_dim}
		},


	grid-outer-border .bool_set:N = \l_nsk_block_grid_outerb_tl,
	grid-outer-border .default:n = {false},
	grid-outer-border .initial:n = {false},

	% store style ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	store-style .bool_set:N = \l_nsk_block_store_style_bool,
	store-style .default:n = {true},
	store-style .initial:n = {false},

	% padding ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
	padding-x .dim_set:N = \l_nsk_block_padding_x_dim,
