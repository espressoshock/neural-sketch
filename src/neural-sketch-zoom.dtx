% \maketitle

% implementation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
%<*package>
%    \begin{macrocode}

% Require necessary packages
\RequirePackage{tikz}
\RequirePackage{expl3}

\usetikzlibrary{spy,}

\ExplSyntaxOn
% Global counter for auto-generated zoom IDs
\int_new:N \g_nsk_zoom_counter_int
\int_zero:N \g_nsk_zoom_counter_int
%
% -----------------------------------------------------------------------------
% Define keys for the nsk / zoom module
% -----------------------------------------------------------------------------
\keys_define:nn { nsk / zoom }
{
	type .tl_set:N = \l_nsk_zoom_type_tl,
	type .initial:V = \g__nsk_style_zoom_type_tl,
	type .default:V = \g__nsk_style_zoom_type_tl,

	at .tl_set:N = \l_nsk_zoom_at_tl,
	at .initial:V = \g__nsk_style_zoom_at_tl,
	at .default:V = \g__nsk_style_zoom_at_tl,

	to .tl_set:N = \l_nsk_zoom_to_tl,
	to .initial:V = \g__nsk_style_zoom_to_tl,
	to .default:V = \g__nsk_style_zoom_to_tl,

	id .tl_set:N = \l_nsk_zoom_id_tl,
	id .initial:n = { },

	magnification .tl_set:N = \l_nsk_zoom_magnification_tl,
	magnification .initial:V = \g__nsk_style_zoom_magnification_tl,
	magnification .default:V = \g__nsk_style_zoom_magnification_tl,

	size .dim_set:N = \l_nsk_zoom_size_dim,
	size .initial:V = \g__nsk_style_zoom_size_dim,
	size .default:V = \g__nsk_style_zoom_size_dim,

	callout-style .tl_set:N = \l_nsk_zoom_callout_style_tl,
	callout-style .initial:V = \g__nsk_style_zoom_callout_style_tl,
	callout-style .default:V = \g__nsk_style_zoom_callout_style_tl,

	connecting-style .tl_set:N = \l_nsk_zoom_connecting_style_tl,
	connecting-style .initial:V = \g__nsk_style_zoom_connecting_style_tl,
	connecting-style .default:V = \g__nsk_style_zoom_connecting_style_tl,

	callout-border-color .tl_set:N = \l_nsk_zoom_callout_border_color_tl,
	callout-border-color .initial:V = \g__nsk_style_zoom_callout_border_color_tl,
	callout-border-color .default:V = \g__nsk_style_zoom_callout_border_color_tl,

	zoomed-style .tl_set:N = \l_nsk_zoom_zoomed_style_tl,
	zoomed-style .initial:V = \g__nsk_style_zoom_zoomed_style_tl,
	zoomed-style .default:V = \g__nsk_style_zoom_zoomed_style_tl,

	zoomed-fill .tl_set:N = \l_nsk_zoom_zoomed_fill_tl,
	zoomed-fill .initial:V = \g__nsk_style_zoom_zoomed_fill_tl,
	zoomed-fill .default:V = \g__nsk_style_zoom_zoomed_fill_tl,

	connecting-path .tl_set:N = \l_nsk_zoom_connecting_path_tl,
	connecting-path .initial:V = \g__nsk_style_zoom_connecting_path_tl,
	connecting-path .default:V = \g__nsk_style_zoom_connecting_path_tl,
}

% -----------------------------------------------------------------------------
% Function: \nsk__maybe_set_zoom_id:
%  If the user did not provide an "id", then auto-generate one in the form
%  "zoom-<int>", using the global counter.
% -----------------------------------------------------------------------------
\cs_new_protected_nopar:Npn \nsk__maybe_set_zoom_id:
{
	\tl_if_blank:VTF \l_nsk_zoom_id_tl
	{
		\int_incr:N \g_nsk_zoom_counter_int
		\tl_set:Nx \l_nsk_zoom_id_tl
		{ zoom-\int_use:N \g_nsk_zoom_counter_int }
	}
	{ }
}

\cs_new_protected_nopar:Npn \nsk__draw_spy_aux:nnnnnnnnn #1#2#3#4#5#6#7#8#9
{

\spy[
\l_nsk_zoom_type_tl,
every~spy~on~node/.style={#3, draw=#7},
size=#5,
magnification=#6,
spy~connection~path={#8}
]~on~(#1)
in~node~[#4, fill=#9]~at~#2;

}


\cs_generate_variant:Nn \nsk__draw_spy_aux:nnnnnnnnn { VVVVVVVVV }

% -----------------------------------------------------------------------------
% Main user command: \nskZoom
%
% Usage: \nskZoom[<key=value list>]{<callout content>}{<zoomed content>}
%
% This command sets the zoom module keys, auto-generates an id if needed, and
% draws a TikZ picture with two nodes (one for the callout and one for the zoomed content)
% connected by a line drawn using the "connecting-path" options.
% -----------------------------------------------------------------------------
\NewDocumentCommand \nskZoom { sO{} }
{
	\IfBooleanTF{#1}
	{
		% Starred form: auto-expand keys
		\edef\l_tmpa_tl{#2}
		\expandafter\nskZoomR\expandafter[\l_tmpa_tl]
	}
	{
		\nskZoomR[#2]
	}
}
\NewDocumentCommand \nskZoomR { O{}}
{
	\group_begin:
	% Process the optional key=value options for the zoom module.
	\keys_set:nn { nsk / zoom } { #1 }
	% Auto-generate the zoom id if not supplied.
	\nsk__maybe_set_zoom_id:

	% Draw the zoom element using a TikZ picture
	\nsk__draw_spy_aux:VVVVVVVVV
	\l_nsk_zoom_at_tl
	\l_nsk_zoom_to_tl
	\l_nsk_zoom_callout_style_tl
	\l_nsk_zoom_zoomed_style_tl
	\l_nsk_zoom_size_dim
	\l_nsk_zoom_magnification_tl
	\l_nsk_zoom_callout_border_color_tl
	\l_nsk_zoom_connecting_path_tl
	\l_nsk_zoom_zoomed_fill_tl


	\group_end:
}

\ExplSyntaxOff

