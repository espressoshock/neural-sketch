% \title{neural-sketch-render.sty\\[1ex]
%        Conditional multi-type code render for neural-sketch}
% \author{Vincenzo Buono}
% \date{\today}
% \maketitle
%
% \section{Introduction}
% This file provides conditional code rendering in a switch-like interface
%
% \StopEventually{}
%
% implementation ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
%<*package>
%    \begin{macrocode}
\ExplSyntaxOn


% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Internal variables -
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\tl_clear_new:N \l__nsk_switch_type_tl
\tl_clear_new:N \l__nsk_switch_operand_tl
\bool_new:N \l__nsk_switch_matched_bool
\clist_new:N \l__nsk_case_values_clist

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Main nsk / render Primitive
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\keys_define:nn { nsk / render }
{
	type .choice:,
	type / string .code:n = { \tl_set:Nn \l__nsk_switch_type_tl { string } },
	type / int    .code:n = { \tl_set:Nn \l__nsk_switch_type_tl { int } },
	type / float  .code:n = { \tl_set:Nn \l__nsk_switch_type_tl { float } },
	type / bool   .code:n = { \tl_set:Nn \l__nsk_switch_type_tl { bool } },
	type .initial:n = { string },
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Helper: check if single value matches operand according to type
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\prg_new_conditional:Npnn \__nsk_value_matches:n #1 { TF }
{
	\str_case:VnF \l__nsk_switch_type_tl
	{
		{string}{ \str_if_eq:VnTF \l__nsk_switch_operand_tl {#1} { \prg_return_true: } { \prg_return_false: } }
		{int}{ \int_compare:nTF { \int_eval:n { \l__nsk_switch_operand_tl } = \int_eval:n {#1} } { \prg_return_true: } { \prg_return_false: } }
		{float}{ \fp_compare:nTF { \fp_eval:n { \l__nsk_switch_operand_tl } == \fp_eval:n {#1} } { \prg_return_true: } { \prg_return_false: } }
		{bool}{ \str_if_eq:VnTF \l__nsk_switch_operand_tl {#1} { \prg_return_true: } { \prg_return_false: } }
	}
	{ \prg_return_false: }
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
% Public Interface
% - (user-facing)
% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
\NewDocumentEnvironment{nskSwitch}{ O{} m }
{
	\group_begin:
	\keys_set:nn { nsk / render } {#1}
	\tl_set:Nx \l__nsk_switch_operand_tl {#2}
	\bool_set_false:N \l__nsk_switch_matched_bool
}
{ \group_end: }

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
% If no previous case has matched, compares the switch operand with each
% comma-separated case value (according to the chosen type) and, if any match,
% sets the flag and executes the code in a group.
% For single values (no comma), uses direct comparison to preserve spaces.
\NewDocumentCommand{\nskCase}{ d[] +m }
{
	\bool_if:NF \l__nsk_switch_matched_bool
	{
		% Check if argument contains a comma (multi-value case)
		\tl_if_in:nnTF {#1} {,}
		{
			% Multi-value: parse as comma-separated list
			\clist_set:Nn \l__nsk_case_values_clist {#1}
			\clist_map_inline:Nn \l__nsk_case_values_clist
			{
				\bool_if:NF \l__nsk_switch_matched_bool
				{
					\__nsk_value_matches:nTF {##1}
					{ \bool_set_true:N \l__nsk_switch_matched_bool \clist_map_break: }
					{ }
				}
			}
		}
		{
			% Single value: direct comparison (preserves spaces)
			\__nsk_value_matches:nTF {#1}
			{ \bool_set_true:N \l__nsk_switch_matched_bool }
			{ }
		}

		% Execute body if matched
		\bool_if:NT \l__nsk_switch_matched_bool
		{ \group_begin: #2 \group_end: }
	}
}

% ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ <<<
% If no case has matched, execute the default code.
\NewDocumentCommand{\nskDefault}{ +m }
{
	\bool_if:NF \l__nsk_switch_matched_bool
	{
		\group_begin: #1 \group_end:
	}
}

\ExplSyntaxOff

